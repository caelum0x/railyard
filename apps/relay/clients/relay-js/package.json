{
  "name": "@relay/sdk",
  "version": "0.1.0",
  "description": "Native JavaScript/TypeScript client SDK for the Relay inference gateway (OpenAI-compatible chat completions, SSE streaming, models, and credits).",
  "license": "Apache-2.0",
  "author": "Relay",
  "homepage": "https://github.com/relay-sdk/relay",
  "bugs": {
    "url": "https://github.com/relay-sdk/relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relay-sdk/relay.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
