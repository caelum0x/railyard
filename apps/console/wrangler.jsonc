{
	// Railyard console on Cloudflare Workers (OpenNext adapter), our account.
	// Nothing secret lives here. Secrets are set with `wrangler secret put`
	// by the owner: DODO_API_KEY, DODO_WEBHOOK_SECRET, SCRIBASE_ANON_KEY,
	// SCRIBASE_SERVICE_ROLE_KEY, RAILYARD_SESSION_SECRET, RAILYARD_SCRIBASE_BRIDGE_SECRET,
	// INSIGHTS_API_TOKEN, RELAY_TENANT_KEY, RAILYARD_CREDENTIALS_KEY.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "railyard-console",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	// Until the Railyard domain and Dodo brand exist (owner items 11 and 18).
	"routes": [{ "pattern": "railyard.ereboslab.com", "custom_domain": true }],
	// The collector's site entries (RYP-E1, PY1.3): the same namespace the edge
	// collector reads: namespace RAILYARD_SITES, created 2026-09-30.
	"kv_namespaces": [{ "binding": "SITES", "id": "323121abfdc64ff6ab90927620d3dbb2" }],
	"vars": {
		"RAILYARD_CONSOLE_URL": "https://railyard.ereboslab.com",
		// Must be this project's own gateway host, never the control-plane API
		// (api.scribase.com) — see lib/config.ts's readConfig guard, added after
		// 2026-10-14's misconfiguration shipped a console that rendered but could
		// never sign anyone in. Real project provisioned 2026-10-27 (temporary,
		// 72h TTL — see DEPLOY.md for the permanent-project follow-up).
		"SCRIBASE_URL": "https://tmp-2166d461a77eddee12cbf35f-railyard-console-prov-3c10ee6e.scribase.com",
		// Insights tenant API (the box's tunnel route to the fork's /api/v1); token is a secret.
		"INSIGHTS_API_URL": "",
		// Relay's OpenAI-compatible base for the BYOK AI gateway (PY1.4); the tenant key is a secret.
		"RELAY_URL": "",
		"RAILYARD_INSIGHTS_URL": "https://insights.railyard.ereboslab.com",
		"DODO_API_BASE": "https://test.dodopayments.com"
	}
}
