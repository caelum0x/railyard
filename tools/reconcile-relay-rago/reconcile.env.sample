# /etc/products/reconcile-relay-rago.env (RY-RG1). No secrets: psql runs inside the
# shared Postgres container over its local socket, in READ ONLY transactions.
# Every line is optional; the values below are the defaults.
#RECON_PSQL=docker exec -i postgres-postgres-1 psql -U postgres
#RECON_RELAY_DB=relay
#RECON_RAGO_DB=rago
#RECON_METRIC_CODE=relay_llm_usage
# Page when drift is over this share of the day's Relay charges (0.005 = 0.5%).
#RECON_DRIFT_PAGE=0.005
# A row still undelivered after this many seconds counts as overdue.
#RECON_PENDING_GRACE_S=3600
# Set to 1 once RELAY_COST_FEED_URL is on (checklist step 3): overdue rows then
# count as drift and page. While 0, a feed that is off only shows in the report.
#RECON_EXPECT_FEED=0
#RECON_VM_IMPORT_URL=http://127.0.0.1:8428/api/v1/import/prometheus
#RECON_STATE_DIR=/var/lib/railyard/reconcile-relay-rago
#RECON_MONITORING_ENV=/etc/products/monitoring.env
