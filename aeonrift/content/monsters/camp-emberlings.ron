// Emberlings camp — a Broodmother leading two Hatchlings. No buff. Aggro is shared:
// hitting one pulls the brood. Placement + respawn in jungle-layout-riftline.ron.
CampSpec(
    id: "camp_emberlings",
    display_name: "Emberlings",
    kind: "MonsterCamp",
    members: [
        (monster: "emberling_broodmother", count: 1),
        (monster: "emberling_hatchling",   count: 2),
    ],
    grants_buff: "none",
    shared_aggro: true,
    leash_radius: 11.0,
)
