        armor: 14,
        magic_resist: 8,
        attack_damage: 22,
        attack_speed: 0.6,
        attack_range: 1.0,
        move_speed: 0.0,
    ),

    scaling: "monster_scaling",

    grants_buff: "none",
    bounty: (gold_local: 8, gold_shared: 0, xp: 15),
)
