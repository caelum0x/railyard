# Aeonrift — 챔피언 현지화 (ko)
#
# 고유명사(챔피언 이름)는 원본과 동일하게 유지됩니다.
# 번역 대상은 칭호(.title)와 한 줄 설명(.lore)입니다.
# 슬러그는 content/champions/*.ron 과 정확히 일치합니다.

## 기본

champion-sentinel = Sentinel
    .title = 기준점
    .lore = 믿음직하고 강력한 기본 공격과 적당한 자가 회복을 갖춘 순수 평타형 챔피언 — 모든 챔피언을 재는 잣대.

champion-pyromancer = Pyromancer
    .title = 잉걸불술사
    .lore = 평타형 챔피언보다 긴 사거리로 접근하기 전에 기절시키는 원거리 화염구를 중심으로 한 폭발형 메이지.

champion-vanguard = Vanguard
    .title = 강철파쇄자
    .lore = 대상에게 돌진해 강한 피해를 주고 잠시 기절시키는 전형적인 이니시에이터 브루저.

## 그리스

champion-zeus = Zeus
    .title = 올림포스의 왕
    .lore = 기절시키는 원거리 번개를 내리치고, 피해와 둔화를 주는 폭풍으로 뒷받침하는 폭발형 메이지.

champion-hades = Hades
    .title = 지하 세계의 군주
    .lore = 적을 기절로 끌어당기고 바닥을 영혼불로 뒤덮으며 죽은 자에게서 힘을 얻는 공허 제어형 탱커.

champion-athena = Athena
    .title = 지혜의 여신
    .lore = 자신에게 보호막을 두르고 둔화시키는 올빼미로 적을 옭아매며 기절시키는 팔랑크스를 지휘하는 수호형 서포터.

champion-medusa = Medusa
    .title = 고르곤
    .lore = 대상을 돌로 만드는 석화의 시선을 지녔고, 둔화시키는 독 사격으로 뒷받침하는 원거리 딜러.

champion-achilles = Achilles
    .title = 트로이의 영웅
    .lore = 기절시키는 창으로 적에게 뛰어들고 불멸의 분노가 폭발하며 상처를 떨쳐내는 거의 무적에 가까운 브루저.

champion-artemis = Artemis
    .title = 사냥의 여신
    .lore = 초승달 베기로 뛰어들어 도망치는 먹잇감을 표식하고 달빛의 치명적인 화살을 쏘아 보내는 암살자.

## 노르드

champion-tyr = Tyr
    .title = 법의 신
    .lore = 적 하나를 제자리에 묶어두고 막대한 체력과 강한 자가 유지력으로 버텨내는 굳건한 탱커.

champion-thor = Thor
    .title = 천둥의 신
    .lore = 기절시키는 망치를 던지고 돌진하며 둔화시키는 천둥 지대를 불러오는 폭풍 브루저.

champion-odin = Odin
    .title = 만신의 아버지
    .lore = 빗나가지 않는 창이 멀리서 기절시키고 까마귀들이 지역을 갈라 둔화시키는 긴 사거리 폭발형 메이지.

champion-loki = Loki
    .title = 장난꾼
    .lore = 표식된 대상에게 순간이동해 로스터 최고의 폭발 딜을 넣은 뒤 자가 회복과 함께 사라지는 암살자.

champion-freyja = Freyja
    .title = 바니르의 여주인
    .lore = 큰 자가 회복, 기절시키며 옭아매는 스킬샷, 둔화시키는 매의 망토를 지닌 인챈터 서포터.

champion-ullr = Ullr
    .title = 활의 신
    .lore = 서리로 둔화시키고 지역에 화살을 퍼부으며 재배치 대시로 미끄러져 빠져나가는 긴 사거리 원거리 딜러.

## 로마

champion-mars = Mars
    .title = 전쟁의 신
    .lore = 규율 잡힌 전쟁 브루저 — 순수한 분노가 아닌 전술로 싸우는 로마 장군.

champion-vulcan = Vulcan
    .title = 대장간의 아버지
    .lore = 녹아내린 대지로 공간을 지배하는 대장간 탱커이자 구역 통제자.

champion-bellona = Bellona
    .title = 전쟁의 여신
    .lore = 빠르고 긴 사거리의 평타와 붙잡아두는 일제 사격을 지닌 무기 명인 원거리 딜러.

champion-neptune = Neptune
    .title = 조수의 군주
    .lore = 강력한 둔화를 지닌 긴 사거리 파도를 풀어놓는 연약한 폭발형 메이지.

champion-mercury = Mercury
    .title = 신속을 전하는 자
    .lore = 맹렬한 이동 속도, 파고드는 폭발, 빠져나가는 대시를 지닌 속도형 암살자.

champion-janus = Janus
    .title = 두 얼굴의 신
    .lore = 기동력, 유지력, 그리고 관문을 내려찍는 속박을 제공하는 차원문 서포터.

## 이집트

champion-ra-radiant-dawn = Ra
    .title = 찬란한 여명
    .lore = 넓은 태양불 폭발로 밀집한 적을 지워버리고 꿰뚫는 태양 창으로 견제하는 폭발형 메이지.

champion-anubis-warden-of-scales = Anubis
    .title = 저울의 감시자
    .lore = 강력한 기절로 적을 묶어두고 지역 전체를 둔화로 짓누르는 제어형 탱커.

champion-horus-skyfall-talon = Horus
    .title = 낙하하는 발톱
    .lore = 기절시키는 매 대시로 내리꽂고 무겁고 둔화시키는 타격으로 적을 갈아버리는 브루저.

champion-isis-mother-of-magic = Isis
    .title = 마법의 어머니
    .lore = 막대한 자가 회복, 기절시키는 속박 주문, 긴 지역 둔화를 바탕으로 한 서포터.

champion-set-lord-of-chaos = Set
    .title = 혼돈의 군주
    .lore = 먼 거리를 도약해 대상 위에서 폭발한 뒤 회복하고 빠져나가는 암살자.

champion-bastet-claws-of-the-hunt = Bastet
    .title = 사냥의 발톱
    .lore = 빠른 기본 공격으로 적을 찢어발기고 둔화시키는 발톱과 아홉 목숨의 회복으로 카이팅하는 고양이 원거리 딜러.

## 잉걸불

champion-toran = Toran
    .title = 쇳물찌꺼기 감시자
    .lore = 강력한 기절로 전투를 고정하고 대장간이 공급하는 회복으로 몸을 식히는 전선 탱커.

champion-vashka = Vashka
    .title = 잉걸아가리
    .lore = 불타는 돌진으로 간격을 좁히고 끈적한 둔화와 자가 유지력으로 교전하는 파고드는 브루저.

champion-ysmera = Ysmera
    .title = 화장단의 예언자
    .lore = 지역 폭발과 긴 사거리 창으로 한 번의 연계에 연약한 적을 지워버리는 연약한 폭발형 메이지.

champion-kaeza = Kaeza
    .title = 잉걸불 잠금술사
    .lore = 지속 피해, 꿰뚫는 화살, 재배치 도약을 지닌 원거리 딜러.

champion-nerreth = Nerreth
    .title = 잿더미 추적자
    .lore = 대상에게 순간이동해 기절과 폭발 연계를 쏟아붓고 이탈하는 폭발형 암살자.

## 조수

champion-brackmoor = Brackmoor
    .title = 조수 감시자
    .lore = 강력한 빙결, 자가 유지력, 아군을 지키는 둔화 충격파를 지닌 전선 탱커.

champion-nyxralla = Nyxralla
    .title = 심연을 부르는 자
    .lore = 높은 계수의 창과 둔화시키는 개화로 대상을 폭발시키는 연약하고 긴 사거리의 폭발형 메이지.

champion-cyranth = Cyranth
    .title = 암초 추적자
    .lore = 높은 지속 피해, 강하게 적중하는 스킬샷, 카이팅용 단일 대상 둔화를 지닌 원거리 딜러.

champion-veyl = Veyl
    .title = 저류
    .lore = 간격을 좁히는 대시 폭발과 속박 처형을 지닌 암살자 — 연약하지만 기동력이 뛰어나다.

champion-lumisel = Lumisel
    .title = 조수를 노래하는 자
    .lore = 무게가 다른 두 가지 회복과 아군을 지키는 둔화·지속 피해 구역을 지닌 인챈터 서포터.

## 푸른숲

champion-mosscloak = Mosscloak
    .title = 숲의 감시자
    .lore = 피해를 흡수하고 위협 하나를 속박하며 자신의 나무껍질을 재생하는 전선 탱커.

champion-gorehoof = Gorehoof
    .title = 피의 뿌리
    .lore = 충돌 시 비틀거리게 하고 타격을 주고받으며 피뿌리에서 마셔 전투를 이어가는 파고드는 브루저.

champion-sporeveil = Sporeveil
    .title = 부패의 꽃
    .lore = 포자 개화를 터뜨리고 구역을 꽃가루로 질식시키며 낙오자를 저격하는 연약한 폭발형 메이지.

champion-thornquill = Thornquill
    .title = 가시덤불 파수꾼
    .lore = 성장하는 가시를 퍼붓고 꿰뚫는 깃털로 무력화하며 거리를 유지하려 튀어 오르는 원거리 딜러.

champion-petalsong = Petalsong
    .title = 꽃을 노래하는 자
    .lore = 핵심 대상을 묶어두고 달라붙는 덩굴로 무리를 질식시키며 노래로 자신의 상처를 아물게 하는 방해형 서포터.

## 그림자

champion-dregmaw = Dregmaw
    .title = 황혼의 방벽
    .lore = 월식철에 융합되어 고통을 흡수하고 그림자 손아귀로 위협을 옭아매며 어둠 속에서 치유하는 전선 탱커.

champion-korrathil = Korrathil
    .title = 공허를 삼키는 자
    .lore = 먹잇감 위로 내리꽂아 제자리에 붙들고 자신의 상처가 아물 때까지 게걸스레 먹는 파고드는 브루저.

champion-xelphine = Xelphine
    .title = 월식의 예언자
    .lore = 발밑에 그림자를 피우고 먼 먹잇감을 창으로 꿰뚫으며 완전한 밤을 불러오는 연약한 폭발형 메이지.

champion-quorvane = Quorvane
    .title = 밤유리 사냥꾼
    .lore = 시야 가장자리에서 공허 유리 파편을 쏘고 꿰뚫는 사격으로 도망치는 먹잇감을 붙박는 인내심 깊은 원거리 딜러.

champion-zeryth = Zeryth
    .title = 그림자의 송곳니
    .lore = 표식된 대상과의 거리를 접어 비명 도중에 붙박고 어둠 속에서 끝장내는, 살아 있는 그림자로 이루어진 폭발형 암살자.
