# Aeonrift — Localisation des champions (fr)
#
# Les noms propres (noms des champions) restent volontairement identiques à l'original.
# Seuls le titre (.title) et la description en une ligne (.lore) sont traduits.
# Les slugs correspondent exactement à content/champions/*.ron.

## Base

champion-sentinel = Sentinel
    .title = L'Étalon
    .lore = Un pur attaquant automatique aux coups de base fiables et puissants, doté d'une modeste autoguérison — la référence de tous les autres.

champion-pyromancer = Pyromancer
    .title = Le Braisier
    .lore = Un mage à burst bâti autour d'une boule de feu à longue portée qui surpasse les attaquants et étourdit avant qu'ils ne se rapprochent.

champion-vanguard = Vanguard
    .title = Le Brise-Fer
    .lore = Un bagarreur qui bondit sur une cible, frappe lourdement et étourdit brièvement — une amorce classique.

## Grecs

champion-zeus = Zeus
    .title = Roi de l'Olympe
    .lore = Un mage à burst qui invoque un éclair à longue portée qui étourdit, soutenu par une tempête qui inflige des dégâts et ralentit.

champion-hades = Hades
    .title = Seigneur des Enfers
    .lore = Un tank contrôleur du néant qui attire un ennemi avec un étourdissement, recouvre le sol de feu des âmes et se nourrit des morts.

champion-athena = Athena
    .title = Déesse de la Sagesse
    .lore = Un soutien gardien qui se protège d'un bouclier, entrave les ennemis avec une chouette ralentissante et commande une phalange étourdissante.

champion-medusa = Medusa
    .title = La Gorgone
    .lore = Une tireuse dont le regard pétrifiant change une cible en pierre, soutenu par un tir de venin qui ralentit.

champion-achilles = Achilles
    .title = Héros de Troie
    .lore = Un bagarreur quasi invincible qui plonge sur un ennemi avec une lance étourdissante et ignore ses blessures dans un accès de rage immortelle.

champion-artemis = Artemis
    .title = Déesse de la Chasse
    .lore = Une assassine qui bondit avec une frappe en croissant, marque les proies en fuite et décoche une volée mortelle de clair de lune.

## Nordiques

champion-tyr = Tyr
    .title = Dieu de la Loi
    .lore = Un tank inébranlable qui immobilise un ennemi unique et tient bon grâce à des points de vie massifs et une forte autosuffisance.

champion-thor = Thor
    .title = Dieu du Tonnerre
    .lore = Un bagarreur de la tempête qui lance un marteau étourdissant, charge et invoque une zone de tonnerre ralentissante.

champion-odin = Odin
    .title = Le Père de Tout
    .lore = Un mage à burst à longue allonge dont la lance ne manquant jamais étourdit de loin tandis que ses corbeaux découpent une zone et ralentissent.

champion-loki = Loki
    .title = Le Filou
    .lore = Un assassin qui se téléporte vers une marque pour le plus haut burst de la sélection, puis disparaît avec une autoguérison.

champion-freyja = Freyja
    .title = Dame des Vanes
    .lore = Un soutien enchanteur doté d'une grande autoguérison, d'un tir de compétence entravant qui étourdit et d'un manteau de faucon ralentissant.

champion-ullr = Ullr
    .title = Dieu de l'Arc
    .lore = Un tireur à longue portée qui ralentit avec du givre, fait pleuvoir une volée sur une zone et s'esquive au loin d'une ruée de repositionnement.

## Romains

champion-mars = Mars
    .title = Dieu de la Guerre
    .lore = Un bagarreur de guerre discipliné — un général romain qui combat avec méthode, non avec une fureur brute.

champion-vulcan = Vulcan
    .title = Le Père de la Forge
    .lore = Un tank de forge et contrôleur de zone qui domine l'espace avec un sol en fusion.

champion-bellona = Bellona
    .title = Déesse de la Guerre
    .lore = Une tireuse maîtresse d'armes aux attaques automatiques rapides et à longue portée, dotée d'une volée clouante.

champion-neptune = Neptune
    .title = Seigneur des Marées
    .lore = Un mage à burst fragile qui déchaîne des vagues à longue portée aux lourds ralentissements.

champion-mercury = Mercury
    .title = Le Porteur de Vitesse
    .lore = Un assassin de vitesse à la célérité fulgurante, doté d'un burst d'entrée en ruée et d'une esquive de sortie.

champion-janus = Janus
    .title = Le Bifront
    .lore = Un soutien de portails offrant mobilité, endurance et un verrouillage par claquement de porte.

## Égyptiens

champion-ra-radiant-dawn = Ra
    .title = Aube Radieuse
    .lore = Un mage à burst qui efface les ennemis groupés d'une large nova de feu solaire et harcèle d'une lance solaire perforante.

champion-anubis-warden-of-scales = Anubis
    .title = Gardien des Balances
    .lore = Un tank de contrôle qui immobilise les ennemis d'un étourdissement puissant et écrase toute une zone dans un ralentissement.

champion-horus-skyfall-talon = Horus
    .title = Serre Fondue du Ciel
    .lore = Un bagarreur qui plonge d'une ruée de faucon étourdissante et use les ennemis de frappes lourdes et ralentissantes.

champion-isis-mother-of-magic = Isis
    .title = Mère de la Magie
    .lore = Un soutien bâti sur une énorme autoguérison, un sort de ligotage étourdissant et un long ralentissement de zone.

champion-set-lord-of-chaos = Set
    .title = Seigneur du Chaos
    .lore = Un assassin qui bondit sur une immense distance pour détoner sur une cible, puis se soigne et s'esquive.

champion-bastet-claws-of-the-hunt = Bastet
    .title = Griffes de la Chasse
    .lore = Une tireuse féline dont les coups de base rapides lacèrent les ennemis, esquivant avec une griffe ralentissante et une récupération aux neuf vies.

## Ember

champion-toran = Toran
    .title = Le Gardien des Scories
    .lore = Un tank de première ligne qui ancre les combats d'un étourdissement lourd et se refroidit d'une guérison nourrie par la forge.

champion-vashka = Vashka
    .title = Gueule de Cendre
    .lore = Un bagarreur plongeur qui comble la distance d'une charge ardente et échange avec des ralentissements collants et de l'autosuffisance.

champion-ysmera = Ysmera
    .title = L'Oracle du Bûcher
    .lore = Une mage à burst fragile dont les détonations de zone et la lance à longue portée effacent les fragiles en une seule rotation.

champion-kaeza = Kaeza
    .title = La Verrou de Braise
    .lore = Une tireuse à distance aux dégâts soutenus, dotée d'un carreau perforant et d'un saut de repositionnement.

champion-nerreth = Nerreth
    .title = Le Traqueur de Cendres
    .lore = Un assassin à burst qui se téléporte sur une cible, déverse un combo étourdissement-burst et se désengage.

## Tide

champion-brackmoor = Brackmoor
    .title = Le Gardien des Marées
    .lore = Un tank de première ligne doté d'un gel puissant, d'autosuffisance et d'une onde de choc ralentissante pour protéger les alliés.

champion-nyxralla = Nyxralla
    .title = L'Appel des Profondeurs
    .lore = Une mage à burst fragile et à longue portée qui détone ses cibles d'une lance à haut ratio et d'une éclosion ralentissante.

champion-cyranth = Cyranth
    .title = Le Traqueur des Récifs
    .lore = Un tireur aux dégâts soutenus élevés, doté d'un tir de compétence puissant et d'un ralentissement monocible pour esquiver.

champion-veyl = Veyl
    .title = Le Ressac
    .lore = Un assassin doté d'une ruée burst comblant la distance et d'une exécution de verrouillage — fragile mais mobile.

champion-lumisel = Lumisel
    .title = La Chanteuse des Marées
    .lore = Un soutien enchanteur doté de deux guérisons d'intensités différentes et d'une zone ralentissante à dégâts d'usure pour protéger.

## Verdant

champion-mosscloak = Mosscloak
    .title = Le Gardien du Bosquet
    .lore = Un tank de première ligne qui encaisse les dégâts, enracine une menace unique et fait repousser sa propre écorce.

champion-gorehoof = Gorehoof
    .title = La Racine de Sang
    .lore = Un bagarreur plongeur qui déséquilibre à l'impact, échange des coups et boit à la racine de sang pour rester dans le combat.

champion-sporeveil = Sporeveil
    .title = La Fleur de Pourriture
    .lore = Une mage à burst fragile qui détone une éclosion de spores, étouffe une zone de pollen et abat les traînards.

champion-thornquill = Thornquill
    .title = La Veille des Ronces
    .lore = Un tireur qui fait pleuvoir des barbelures évolutives, estropie d'un dard perforant et bondit au loin pour garder ses distances.

champion-petalsong = Petalsong
    .title = La Chanteuse des Fleurs
    .lore = Un soutien perturbateur qui verrouille une cible clé, étouffe un groupe de lianes agrippantes et referme ses blessures en chantant.

## Umbral

champion-dregmaw = Dregmaw
    .title = Le Rempart du Crépuscule
    .lore = Un tank de première ligne fusionné au fer d'éclipse qui encaisse les coups, enchaîne une menace d'une poigne d'ombre et se soigne dans l'obscurité.

champion-korrathil = Korrathil
    .title = Le Dévoreur du Néant
    .lore = Un bagarreur plongeur qui s'abat sur sa proie, la maintient en place et se nourrit jusqu'à ce que ses propres blessures se referment.

champion-xelphine = Xelphine
    .title = La Voyante de l'Éclipse
    .lore = Une mage à burst fragile qui fait éclore l'ombre à ses pieds, transperce une proie lointaine et invoque une nuit totale.

champion-quorvane = Quorvane
    .title = Chasseur de Verre Nocturne
    .lore = Un tireur patient qui décoche des éclats de verre du néant depuis la lisière du regard et cloue les proies en fuite d'un tir perforant.

champion-zeryth = Zeryth
    .title = Le Croc d'Ombre
    .lore = Un assassin à burst d'ombre vivante qui plie la distance vers une marque, la cloue en plein cri et l'achève dans les ténèbres.
