# Aeonrift — チャンピオンのローカライズ (ja)
#
# 固有名詞（チャンピオン名）は原典に合わせて意図的に同一のままにしています。
# 翻訳するのは称号 (.title) と一行説明 (.lore) です。
# スラッグは content/champions/*.ron と完全に一致します。

## ベースライン

champion-sentinel = Sentinel
    .title = 基準点
    .lore = 信頼できる強力な通常攻撃とほどよい自己回復を備えた、純粋なオートアタッカー——すべての基準となる存在。

champion-pyromancer = Pyromancer
    .title = 灰燼を放つ者
    .lore = 長射程の火球を軸にしたバーストメイジ。オートアタッカーより先に届き、接近される前にスタンさせる。

champion-vanguard = Vanguard
    .title = 鉄砕き
    .lore = 標的へ突進して大ダメージを叩き込み、短くスタンさせるブルーザー——王道のイニシエート。

## ギリシャ

champion-zeus = Zeus
    .title = オリュンポスの王
    .lore = 長射程の雷を落としてスタンさせるバーストメイジ。ダメージと減速を与える嵐が後を支える。

champion-hades = Hades
    .title = 冥界の主
    .lore = 敵をスタンで引き寄せ、地面を魂の炎で覆い、死者を糧とするヴォイド制圧型タンク。

champion-athena = Athena
    .title = 知恵の女神
    .lore = 自らを守護し、減速のフクロウで敵を捕らえ、スタンを放つ密集陣を指揮するガーディアンサポート。

champion-medusa = Medusa
    .title = ゴルゴン
    .lore = 石化の視線で標的を石に変えるマークスマン。減速効果のある毒の一撃が後を支える。

champion-achilles = Achilles
    .title = トロイアの英雄
    .lore = スタンの槍で敵に飛び込み、不滅の怒りの爆発で傷を振り払う、ほぼ無敵のブルーザー。

champion-artemis = Artemis
    .title = 狩猟の女神
    .lore = 三日月の一撃で飛び込み、逃げる獲物に印をつけ、月光の必殺の一斉射を放つアサシン。

## 北欧

champion-tyr = Tyr
    .title = 法の神
    .lore = 敵一体をその場に縛りつけ、膨大な体力と強力な自己維持で持ちこたえる不動のタンク。

champion-thor = Thor
    .title = 雷の神
    .lore = スタンのハンマーを投げて突進し、減速の雷の領域を呼び起こすストームブルーザー。

champion-odin = Odin
    .title = 全能の父
    .lore = 決して外さぬ槍で遠方からスタンさせ、渡り鴉が一帯を切り裂き減速させる長射程のバーストメイジ。

champion-loki = Loki
    .title = 詐術師
    .lore = 標的へ瞬間移動してロスター最高のバーストを叩き込み、自己回復とともに姿を消すアサシン。

champion-freyja = Freyja
    .title = ヴァン神族の淑女
    .lore = 大きな自己回復、スタンを伴う捕縛スキルショット、減速の鷹の外套を備えたエンチャンターサポート。

champion-ullr = Ullr
    .title = 弓の神
    .lore = 霜で減速させ、一帯に矢の雨を降らせ、位置取りのダッシュで滑り去る長射程のマークスマン。

## ローマ

champion-mars = Mars
    .title = 戦の神
    .lore = 規律正しい戦闘型ブルーザー——荒々しい怒りではなく、方法論で戦うローマの将軍。

champion-vulcan = Vulcan
    .title = 鍛冶の父
    .lore = 溶けた地面で空間を支配する、鍛冶場のタンクにしてゾーナー。

champion-bellona = Bellona
    .title = 戦の女神
    .lore = 速く長射程の通常攻撃と敵を縫い留める一斉射を持つ、武器の達人たるマークスマン。

champion-neptune = Neptune
    .title = 潮の主
    .lore = 強力な減速を伴う長射程の波を放つ、脆弱なバーストメイジ。

champion-mercury = Mercury
    .title = 俊足をもたらす者
    .lore = 灼けつく移動速度、飛び込みのバースト、離脱のダッシュを持つスピードアサシン。

champion-janus = Janus
    .title = 二つの顔
    .lore = 機動力、持続力、門を閉ざす行動阻害を提供するポータルサポート。

## エジプト

champion-ra-radiant-dawn = Ra
    .title = 輝ける暁
    .lore = 広範囲の太陽光ノヴァで密集した敵を消し去り、貫通の太陽槍で牽制するバーストメイジ。

champion-anubis-warden-of-scales = Anubis
    .title = 天秤の番人
    .lore = 強力なスタンで敵を抑え込み、一帯全体を押し潰して減速させる制圧型タンク。

champion-horus-skyfall-talon = Horus
    .title = 天翔ける鉤爪
    .lore = スタンの隼のダッシュで急降下し、重く減速する打撃で敵を削り倒すブルーザー。

champion-isis-mother-of-magic = Isis
    .title = 魔法の母
    .lore = 巨大な自己回復、スタンの束縛呪文、長い範囲減速を軸に築かれたサポート。

champion-set-lord-of-chaos = Set
    .title = 混沌の主
    .lore = 遥かな距離を跳んで標的の上で炸裂し、回復して抜け出すアサシン。

champion-bastet-claws-of-the-hunt = Bastet
    .title = 狩りの爪
    .lore = 速い通常攻撃で敵を切り裂き、減速の爪と九つの命の回復でカイトする猫のマークスマン。

## エンバー

champion-toran = Toran
    .title = 鉱滓の番人
    .lore = 重いスタンで戦線を固定し、鍛冶場に養われた回復で自らを冷ますフロントラインのタンク。

champion-vashka = Vashka
    .title = 燼の顎
    .lore = 燃える突進で間合いを詰め、粘着する減速と自己維持で撃ち合うダイブ型ブルーザー。

champion-ysmera = Ysmera
    .title = 薪火の託宣者
    .lore = 範囲の炸裂と長射程の槍で、脆い敵を一連の動作で消し去る脆弱なバーストメイジ。

champion-kaeza = Kaeza
    .title = 燼を閉ざす者
    .lore = 持続ダメージ、貫通のボルト、位置取りのホップを持つ遠隔マークスマン。

champion-nerreth = Nerreth
    .title = 灰を狩る者
    .lore = 標的へ瞬間移動し、スタンとバーストのコンボを叩き込み、離脱するバーストアサシン。

## タイド

champion-brackmoor = Brackmoor
    .title = 潮の番人
    .lore = 強力な凍結、自己維持、味方を守る減速の衝撃波を持つフロントラインのタンク。

champion-nyxralla = Nyxralla
    .title = 深淵を呼ぶ者
    .lore = 高倍率の槍と減速の花で標的を炸裂させる、脆弱で長射程のバーストメイジ。

champion-cyranth = Cyranth
    .title = 珊瑚礁を狩る者
    .lore = 高い持続ダメージ、強打のスキルショット、カイト用の単体減速を持つマークスマン。

champion-veyl = Veyl
    .title = 引き潮
    .lore = 間合いを詰めるダッシュバーストと行動阻害の処刑を持つアサシン——脆いが機動的。

champion-lumisel = Lumisel
    .title = 潮を歌う者
    .lore = 重さの異なる二つの回復と、味方を守る減速・削りダメージの領域を持つエンチャンターサポート。

## ヴァーダント

champion-mosscloak = Mosscloak
    .title = 森の番人
    .lore = ダメージを吸収し、単体の脅威を根で拘束し、自らの樹皮を再生させるフロントラインのタンク。

champion-gorehoof = Gorehoof
    .title = 血の根
    .lore = 着地でよろめかせ、打ち合い、血の根から飲んで戦い続けるダイブ型ブルーザー。

champion-sporeveil = Sporeveil
    .title = 腐りの花
    .lore = 胞子の花を炸裂させ、花粉で一帯を覆い、はぐれ者を狙撃する脆弱なバーストメイジ。

champion-thornquill = Thornquill
    .title = 茨の見張り
    .lore = 成長する棘を降らせ、貫通の羽根で足を止め、跳ねて距離を保つマークスマン。

champion-petalsong = Petalsong
    .title = 花を歌う者
    .lore = 要となる標的を抑え込み、絡みつく蔓で集団を覆い、自らの傷を歌で塞ぐ妨害型サポート。

## アンブラル

champion-dregmaw = Dregmaw
    .title = 黄昏の防壁
    .lore = 蝕の鉄と融合したフロントラインのタンク。攻撃を吸収し、影の握りで脅威を縛り、闇の中で癒える。

champion-korrathil = Korrathil
    .title = 虚無を貪る者
    .lore = 獲物へ墜ちかかり、その場に固定し、自らの傷が塞がるまで喰らうダイブ型ブルーザー。

champion-xelphine = Xelphine
    .title = 蝕の予見者
    .lore = 足元に影を咲かせ、遠くの獲物を槍で貫き、完全な夜を呼び起こす脆弱なバーストメイジ。

champion-quorvane = Quorvane
    .title = 夜硝子の狩人
    .lore = 視界の端から虚無硝子の破片を放ち、貫通弾で逃げる獲物を縫い留める忍耐強いマークスマン。

champion-zeryth = Zeryth
    .title = 影の牙
    .lore = 生ける影のバーストアサシン。標的との距離を畳み、悲鳴の途中で縫い留め、闇の中で仕留める。
