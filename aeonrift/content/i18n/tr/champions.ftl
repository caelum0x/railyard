# Aeonrift — Şampiyon yerelleştirmesi (tr)
#
# Özel adlar (şampiyon isimleri) tasarım gereği orijinaliyle aynı bırakılır.
# Başlık (.title) ve tek satırlık tanıtım (.lore) çevrilir.
# Slug'lar content/champions/*.ron ile birebir aynıdır.

## Temel

champion-sentinel = Sentinel
    .title = Ölçüt
    .lore = Güvenilir ve sert vuran temel saldırıları ve mütevazı bir kişisel iyileştirmesi olan saf bir oto-vurucu — diğer herkesin ölçüldüğü standart.

champion-pyromancer = Pyromancer
    .title = Köz Çağırıcı
    .lore = Nişancıların menzilini aşan ve onlar yaklaşamadan sersemleten uzun menzilli bir ateş topu etrafında kurulu bir patlama büyücüsü.

champion-vanguard = Vanguard
    .title = Demir Kıran
    .lore = Bir hedefin üzerine atılan, ağır vuran ve kısa süreliğine sersemleten bir savaşçı — klasik bir başlatıcı.

## Yunan

champion-zeus = Zeus
    .title = Olympos'un Kralı
    .lore = Sersemleten uzun menzilli bir yıldırım çağıran, hasar veren ve yavaşlatan bir fırtınayla desteklenen bir patlama büyücüsü.

champion-hades = Hades
    .title = Yeraltı Dünyasının Efendisi
    .lore = Bir düşmanı sersemletmeyle içeri çeken, zemini ruh ateşiyle kaplayan ve ölülerden beslenen bir kontrol tankı.

champion-athena = Athena
    .title = Bilgelik Tanrıçası
    .lore = Kendini kalkanla koruyan, düşmanları yavaşlatan bir baykuşla tuzağa düşüren ve sersemleten bir falanksa komuta eden koruyucu bir destek.

champion-medusa = Medusa
    .title = Gorgon
    .lore = Taşlaştıran bakışıyla bir hedefi taşa çeviren, yavaşlatan bir zehir atışıyla desteklenen bir nişancı.

champion-achilles = Achilles
    .title = Truva Kahramanı
    .lore = Sersemleten bir mızrakla bir düşmanın üzerine dalan ve ölümsüz öfke patlamasıyla yaraları savuşturan neredeyse yenilmez bir savaşçı.

champion-artemis = Artemis
    .title = Av Tanrıçası
    .lore = Hilal darbesiyle içeri sıçrayan, kaçan avı işaretleyen ve ölümcül bir ay ışığı yağmuru salan bir suikastçı.

## İskandinav

champion-tyr = Tyr
    .title = Hukuk Tanrısı
    .lore = Tek bir düşmanı yerinde tutan ve devasa can ile güçlü kişisel iyileşmeyle dayanan sarsılmaz bir tank.

champion-thor = Thor
    .title = Şimşek Tanrısı
    .lore = Sersemleten bir çekiç fırlatan, içeri dalan ve yavaşlatan bir gök gürültüsü alanı çağıran bir fırtına savaşçısı.

champion-odin = Odin
    .title = Baştanrı
    .lore = Asla ıskalamayan mızrağı uzaktan sersemletirken kuzgunları bir alanı yarıp yavaşlatan uzun menzilli bir patlama büyücüsü.

champion-loki = Loki
    .title = Düzenbaz
    .lore = Kadronun en yüksek patlaması için bir hedefe ışınlanan, ardından kişisel iyileşmeyle gözden kaybolan bir suikastçı.

champion-freyja = Freyja
    .title = Vanir'in Hanımı
    .lore = Büyük bir kişisel iyileşmesi, sersemleten tuzaklayıcı bir yeteneği ve yavaşlatan bir şahin pelerini olan büyüleyici bir destek.

champion-ullr = Ullr
    .title = Yay Tanrısı
    .lore = Ayazla yavaşlatan, bir alana ok yağmuru yağdıran ve yeniden konumlanmak için kayıp uzaklaşan uzun menzilli bir nişancı.

## Roma

champion-mars = Mars
    .title = Savaş Tanrısı
    .lore = Disiplinli bir savaş savaşçısı — ham öfkeyle değil, yöntemle savaşan bir Romalı general.

champion-vulcan = Vulcan
    .title = Demirci Baba
    .lore = Erimiş zeminle alanı kontrol eden bir demirci tankı ve alan hâkimi.

champion-bellona = Bellona
    .title = Savaş Tanrıçası
    .lore = Hızlı, uzun menzilli oto-saldırıları ve sabitleyen bir ok yağmuru olan silah ustası bir nişancı.

champion-neptune = Neptune
    .title = Gelgitlerin Efendisi
    .lore = Ağır yavaşlatmalarla uzun menzilli dalgalar salan kırılgan bir patlama büyücüsü.

champion-mercury = Mercury
    .title = Hızın Habercisi
    .lore = Baş döndürücü hareket hızı, giriş patlaması ve çıkış atılımı olan hızlı bir suikastçı.

champion-janus = Janus
    .title = İki Yüzlü
    .lore = Hareket kabiliyeti, dayanıklılık ve kapı çarpan bir kilitleme sunan bir portal desteği.

## Mısır

champion-ra-radiant-dawn = Ra
    .title = Işıyan Şafak
    .lore = Geniş bir güneş ateşi novasıyla kümelenmiş düşmanları yok eden ve delici bir güneş mızrağıyla uzaktan taciz eden bir patlama büyücüsü.

champion-anubis-warden-of-scales = Anubis
    .title = Terazinin Bekçisi
    .lore = Düşmanları sert bir sersemletmeyle kilitleyen ve bütün bir alanı yavaşlatmaya sıkıştıran bir kontrol tankı.

champion-horus-skyfall-talon = Horus
    .title = Gökten İnen Pençe
    .lore = Sersemleten bir şahin atılımıyla dalan ve düşmanları ağır, yavaşlatan darbelerle aşındıran bir savaşçı.

champion-isis-mother-of-magic = Isis
    .title = Büyünün Anası
    .lore = Devasa bir kişisel iyileşme, sersemleten bir bağlama büyüsü ve uzun bir alan yavaşlatması üzerine kurulu bir destek.

champion-set-lord-of-chaos = Set
    .title = Kaosun Efendisi
    .lore = Bir hedefin üzerinde patlamak için devasa bir mesafe sıçrayan, ardından iyileşip sıvışan bir suikastçı.

champion-bastet-claws-of-the-hunt = Bastet
    .title = Avın Pençeleri
    .lore = Hızlı temel saldırıları düşmanları parçalayan, yavaşlatan bir pençe ve dokuz canlı bir toparlanmayla mesafe koruyan kedi bir nişancı.

## Ember

champion-toran = Toran
    .title = Cüruf Bekçisi
    .lore = Ağır bir sersemletmeyle çatışmaları demirleyen ve demirci beslemeli bir iyileşmeyle kendini soğutan bir ön saf tankı.

champion-vashka = Vashka
    .title = Kül Ağzı
    .lore = Yanan bir hücumla mesafeyi kapatan ve yapışkan yavaşlatmalar ile kişisel dayanıklılıkla mübadele eden dalışçı bir savaşçı.

champion-ysmera = Ysmera
    .title = Ateş Kâhini
    .lore = Alan patlamaları ve uzun menzilli mızrağı kırılganları tek bir rotasyonda silen kırılgan bir patlama büyücüsü.

champion-kaeza = Kaeza
    .title = Köz Kilitleyici
    .lore = Sürekli hasarı, delici bir cıvatası ve yeniden konumlanma sıçraması olan menzilli bir nişancı.

champion-nerreth = Nerreth
    .title = Kül Avcısı
    .lore = Bir hedefe ışınlanan, sersemletme-patlama komboyu boşaltan ve geri çekilen bir patlama suikastçısı.

## Tide

champion-brackmoor = Brackmoor
    .title = Gelgit Bekçisi
    .lore = Sert bir donma, kişisel dayanıklılık ve müttefikleri korumak için yavaşlatan bir şok dalgası olan bir ön saf tankı.

champion-nyxralla = Nyxralla
    .title = Derinlerin Çağıranı
    .lore = Yüksek oranlı bir mızrak ve yavaşlatan bir çiçeklenmeyle hedefleri patlatan kırılgan, uzun menzilli bir patlama büyücüsü.

champion-cyranth = Cyranth
    .title = Resif Avcısı
    .lore = Yüksek sürekli hasarı, sert vuran bir yeteneği ve mesafe korumak için tek hedefli bir yavaşlatması olan bir nişancı.

champion-veyl = Veyl
    .title = Anafor
    .lore = Mesafe kapatan bir atılım patlaması ve kilitleyen bir infazı olan bir suikastçı — kırılgan ama hareketli.

champion-lumisel = Lumisel
    .title = Gelgit Şarkıcısı
    .lore = Farklı ağırlıklarda iki iyileştirmesi ve korumak için yavaşlatan, ufak hasarlı bir bölgesi olan büyüleyici bir destek.

## Verdant

champion-mosscloak = Mosscloak
    .title = Koru Bekçisi
    .lore = Hasarı emen, tek bir tehdidi köklendiren ve kendi kabuğunu yeniden büyüten bir ön saf tankı.

champion-gorehoof = Gorehoof
    .title = Kan Kökü
    .lore = Çarpışta sendeleten, darbe alışverişi yapan ve savaşta kalmak için kan kökünden içen dalışçı bir savaşçı.

champion-sporeveil = Sporeveil
    .title = Çürük Çiçeği
    .lore = Bir spor çiçeğini patlatan, bir bölgeyi polenle boğan ve geride kalanları nişanlayan kırılgan bir patlama büyücüsü.

champion-thornquill = Thornquill
    .title = Diken Gözcüsü
    .lore = Ölçeklenen dikenler yağdıran, delici bir dikenle sakatlayan ve mesafe korumak için sıçrayıp uzaklaşan bir nişancı.

champion-petalsong = Petalsong
    .title = Çiçek Şarkıcısı
    .lore = Kilit bir hedefi kilitleyen, bir grubu sarılan asmalarla boğan ve kendi yaralarını şarkıyla kapatan bozguncu bir destek.

## Umbral

champion-dregmaw = Dregmaw
    .title = Alacakaranlık Siperi
    .lore = Tutulma demirine kaynaşmış, cezayı emen, bir tehdidi gölge kavrayışıyla zincirleyen ve gölgede iyileşen bir ön saf tankı.

champion-korrathil = Korrathil
    .title = Boşluk Yutan
    .lore = Avının üzerine çarpan, onu yerinde sıkıştıran ve kendi yaraları kapanana dek beslenen dalışçı bir savaşçı.

champion-xelphine = Xelphine
    .title = Tutulma Kâhini
    .lore = Ayaklarının dibinde gölge açtıran, uzaktaki avı mızraklayan ve tam bir gece çağıran kırılgan bir patlama büyücüsü.

champion-quorvane = Quorvane
    .title = Gece Camı Avcısı
    .lore = Görüş kenarından boşluk-camı parçaları ateşleyen ve kaçan avı delici bir atışla sabitleyen sabırlı bir nişancı.

champion-zeryth = Zeryth
    .title = Umbral Diş
    .lore = Hedefine olan mesafeyi katlayan, onu çığlığın ortasında sabitleyen ve karanlıkta bitiren yaşayan gölgeden bir patlama suikastçısı.
