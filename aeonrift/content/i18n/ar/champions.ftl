# Aeonrift — توطين الأبطال (ar)
#
# تبقى أسماء الأعلام (أسماء الأبطال) مطابقة للأصل عمداً.
# يُترجَم اللقب (.title) والوصف المؤلف من سطر واحد (.lore) فقط.
# تتطابق المُعرِّفات (slugs) تماماً مع content/champions/*.ron.

## الأساس

champion-sentinel = Sentinel
    .title = المعيار
    .lore = مهاجم تلقائي صِرف بضربات أساسية موثوقة وقوية وشفاء ذاتي متواضع — المقياس الذي يُقاس به الجميع.

champion-pyromancer = Pyromancer
    .title = مُستحضِر الجمر
    .lore = ساحر انفجاري يعتمد على كرة نار بعيدة المدى تتجاوز مدى المهاجمين التلقائيين وتصعقهم قبل أن يقتربوا.

champion-vanguard = Vanguard
    .title = كاسر الحديد
    .lore = مقاتل يندفع نحو هدفه، يضرب بضرر ثقيل، ويصعق لبرهة — اشتباك كلاسيكي.

## الإغريق

champion-zeus = Zeus
    .title = ملك الأولمب
    .lore = ساحر انفجاري يستدعي صاعقة بعيدة المدى تصعق، مدعومة بعاصفة تُلحق الضرر وتُبطئ.

champion-hades = Hades
    .title = سيّد العالم السفلي
    .lore = دبابة تحكُّم بالفراغ تجذب عدواً بصعقة، وتغطي الأرض بنار الأرواح، وتتغذى على الموتى.

champion-athena = Athena
    .title = إلهة الحكمة
    .lore = ساندة حامية تُدرِّع نفسها، وتقيّد الأعداء ببومة تُبطئ، وتقود كتيبة صاعقة.

champion-medusa = Medusa
    .title = الغورغونة
    .lore = رامية تحوّل نظرتها المُحجِّرة الهدف إلى حجر، مدعومة بطلقة سُم تُبطئ.

champion-achilles = Achilles
    .title = بطل طروادة
    .lore = مقاتل شبه منيع يهوي على عدوه برمح صاعق ويتجاهل الجراح في نوبة غضب خالد.

champion-artemis = Artemis
    .title = إلهة الصيد
    .lore = قاتلة تثب داخلةً بضربة هلالية، تُعلِّم الفريسة الهاربة، وتُطلق وابلاً قاتلاً من ضوء القمر.

## النورس

champion-tyr = Tyr
    .title = إله القانون
    .lore = دبابة صامدة تُقيّد عدواً واحداً في مكانه وتصمد بصحة هائلة وإدامة ذاتية قوية.

champion-thor = Thor
    .title = إله الرعد
    .lore = مقاتل عاصفة يرمي مطرقة صاعقة، يندفع داخلاً، ويستدعي منطقة رعد تُبطئ.

champion-odin = Odin
    .title = أبو الجميع
    .lore = ساحر انفجاري بعيد المدى، رمحه الذي لا يُخطئ يصعق من بعيد بينما تشقّ غربانه منطقةً وتُبطئ.

champion-loki = Loki
    .title = المخادع
    .lore = قاتل يومض نحو هدفه محقِّقاً أعلى انفجار في القائمة، ثم يتلاشى بشفاء ذاتي.

champion-freyja = Freyja
    .title = سيّدة الفانير
    .lore = ساندة ساحرة بشفاء ذاتي كبير، وقذيفة مهارة تُقيّد وتصعق، وعباءة صقر تُبطئ.

champion-ullr = Ullr
    .title = إله القوس
    .lore = رامٍ بعيد المدى يُبطئ بالصقيع، ويُمطر وابلاً على منطقة، وينزلق بعيداً باندفاع لإعادة تموضع.

## الرومان

champion-mars = Mars
    .title = إله الحرب
    .lore = مقاتل حرب منضبط — جنرال روماني يقاتل بمنهجية لا بغضب أعمى.

champion-vulcan = Vulcan
    .title = أبو المصهر
    .lore = دبابة مصهر ومسيطر على المناطق يتحكم في المكان بأرض منصهرة.

champion-bellona = Bellona
    .title = إلهة الحرب
    .lore = رامية أستاذة في السلاح بهجمات تلقائية سريعة بعيدة المدى ووابل يُثبِّت.

champion-neptune = Neptune
    .title = سيّد المدّ والجزر
    .lore = ساحر انفجاري هشّ يُطلق موجات بعيدة المدى بإبطاء ثقيل.

champion-mercury = Mercury
    .title = جالب السرعة
    .lore = قاتل سرعة بسرعة حركة خاطفة، واندفاع دخول انفجاري، واندفاع خروج للهرب.

champion-janus = Janus
    .title = ذو الوجهين
    .lore = ساند بوابات يوفر الحركية والإدامة وإطباق بوابة يُعطِّل.

## المصريون

champion-ra-radiant-dawn = Ra
    .title = الفجر المتلألئ
    .lore = ساحر انفجاري يمحو الأعداء المتجمعين بانفجار شمسي واسع ويُناوش برمح شمسي ثاقب.

champion-anubis-warden-of-scales = Anubis
    .title = حارس الموازين
    .lore = دبابة تحكُّم تُثبِّت الأعداء بصعقة قوية وتسحق منطقة كاملة في إبطاء.

champion-horus-skyfall-talon = Horus
    .title = مخلب الهبوط السماوي
    .lore = مقاتل يهوي باندفاع صقر صاعق ويطحن أعداءه بضربات ثقيلة تُبطئ.

champion-isis-mother-of-magic = Isis
    .title = أمّ السحر
    .lore = ساندة مبنية على شفاء ذاتي ضخم، وتعويذة تقييد تصعق، وإبطاء منطقة طويل.

champion-set-lord-of-chaos = Set
    .title = سيّد الفوضى
    .lore = قاتل يثب مسافة هائلة لينفجر على هدفه، ثم يشفي نفسه وينسلّ بعيداً.

champion-bastet-claws-of-the-hunt = Bastet
    .title = مخالب الصيد
    .lore = رامية سِنّورية تمزّق ضرباتها السريعة الأعداء، تُناور بمخلب يُبطئ وتعافٍ بتسع أرواح.

## Ember

champion-toran = Toran
    .title = حارس الخبث
    .lore = دبابة خط أمامي ترسو المعارك بصعقة ثقيلة وتبرّد نفسها بشفاء يتغذى من المصهر.

champion-vashka = Vashka
    .title = فك الرماد
    .lore = مقاتل غطّاس يُغلق المسافة بشحنة مشتعلة ويتبادل الضربات بإبطاءات لاصقة وإدامة ذاتية.

champion-ysmera = Ysmera
    .title = عرّافة المحرقة
    .lore = ساحرة انفجارية هشّة تمحو انفجاراتها المنطقية ورمحها بعيد المدى الهشين في دورة واحدة.

champion-kaeza = Kaeza
    .title = قافلة الجمر
    .lore = رامية بعيدة المدى بضرر متواصل، وسهم ثاقب، وقفزة لإعادة التموضع.

champion-nerreth = Nerreth
    .title = متعقّب الرماد
    .lore = قاتل انفجاري يومض على هدفه، ويُفرغ تركيبة صعق وانفجار، ثم ينفكّ عن الاشتباك.

## Tide

champion-brackmoor = Brackmoor
    .title = حارس المدّ
    .lore = دبابة خط أمامي بتجميد قوي، وإدامة ذاتية، وموجة صدمة تُبطئ لحماية الحلفاء.

champion-nyxralla = Nyxralla
    .title = نادية الأعماق
    .lore = ساحرة انفجارية هشّة بعيدة المدى تُفجّر الأهداف برمح عالي النسبة وزهرة تُبطئ.

champion-cyranth = Cyranth
    .title = متعقّب الشُّعب
    .lore = رامٍ بضرر متواصل عالٍ، وقذيفة مهارة قوية الضرب، وإبطاء أحادي الهدف للمناورة.

champion-veyl = Veyl
    .title = التيار السفلي
    .lore = قاتل باندفاع انفجاري يُغلق المسافة وإعدام يُعطِّل — هشّ لكنه رشيق.

champion-lumisel = Lumisel
    .title = مغنّية المدّ
    .lore = ساندة ساحرة بشفاءين مختلفي الوزن ومنطقة إبطاء بضرر تآكلي للحماية.

## Verdant

champion-mosscloak = Mosscloak
    .title = حارس الأيكة
    .lore = دبابة خط أمامي تمتصّ الضرر، وتجذّر تهديداً واحداً، وتُعيد إنبات لحائها.

champion-gorehoof = Gorehoof
    .title = الجذر الدموي
    .lore = مقاتل غطّاس يترنّح عند الارتطام، يتبادل الضربات، ويشرب من الجذر الدموي ليبقى في المعركة.

champion-sporeveil = Sporeveil
    .title = زهرة العفن
    .lore = ساحرة انفجارية هشّة تُفجّر زهرة أبواغ، وتخنق منطقةً باللقاح، وتقنص المتخلّفين.

champion-thornquill = Thornquill
    .title = حارس الأشواك
    .lore = رامٍ يُمطر أشواكاً متصاعدة، ويشلّ بريشة ثاقبة، ويثب بعيداً ليحفظ المسافة.

champion-petalsong = Petalsong
    .title = مغنّية الأزهار
    .lore = ساندة مُعطِّلة تُثبِّت هدفاً رئيسياً، وتخنق مجموعةً بكروم متشبثة، وتغنّي جراحها حتى تلتئم.

## Umbral

champion-dregmaw = Dregmaw
    .title = حصن الغسق
    .lore = دبابة خط أمامي مندمجة بحديد الكسوف تمتصّ العقاب، وتقيّد تهديداً بقبضة ظلّية، وتلتئم في الظلّ.

champion-korrathil = Korrathil
    .title = التهم الفراغ
    .lore = مقاتل غطّاس يرتطم بفريسته، ويطبق عليها في مكانها، ويتغذى حتى تلتئم جراحه.

champion-xelphine = Xelphine
    .title = عرّافة الكسوف
    .lore = ساحرة انفجارية هشّة تُزهِر الظلّ عند قدميها، وتطعن الفريسة البعيدة، وتستدعي ليلاً شاملاً.

champion-quorvane = Quorvane
    .title = صيّاد الزجاج الليلي
    .lore = رامٍ صبور يُطلق شظايا زجاج الفراغ من حافة الرؤية ويُثبّت الفريسة الهاربة بطلقة ثاقبة.

champion-zeryth = Zeryth
    .title = ناب الظلّ
    .lore = قاتل انفجاري من ظلّ حيّ يطوي المسافة نحو هدفه، ويُثبّته في منتصف صرخته، ويُجهز عليه في الظلام.
