# Aeonrift — 英雄本地化 (zh，简体中文)
#
# 英雄名称（专有名词）按设计在各语言中保持与原始 IP 一致，
# 以避免为架空英雄杜撰错误的音译；此处翻译标题 (.title) 与一句话简介 (.lore)。
# slug 与 content/champions/*.ron 完全一致。

## 基准

champion-sentinel = Sentinel
    .title = 基准
    .lore = 拥有可靠而沉重的普通攻击和适度自愈的纯普攻英雄——衡量其他所有人的标尺。

champion-pyromancer = Pyromancer
    .title = 余烬术士
    .lore = 以一枚超远射程火球为核心的爆发法师，射程压制射手并在其近身前将其击晕。

champion-vanguard = Vanguard
    .title = 破铁者
    .lore = 突进到目标身上、造成重击并短暂击晕的战士——经典的开团手段。

## 希腊

champion-zeus = Zeus
    .title = 奥林匹斯之王
    .lore = 召唤远程闪电将敌人击晕的爆发法师，辅以造成伤害并减速的风暴。

champion-hades = Hades
    .title = 冥界之主
    .lore = 以击晕将敌人拖入、用灵魂之火覆盖地面并吞噬亡者续航的虚空控制坦克。

champion-athena = Athena
    .title = 智慧女神
    .lore = 为自己护盾、以减速猫头鹰缠住敌人并指挥击晕方阵的守护型辅助。

champion-medusa = Medusa
    .title = 蛇发女妖
    .lore = 以石化凝视将目标化为石头、辅以命中减速毒箭的射手。

champion-achilles = Achilles
    .title = 特洛伊英雄
    .lore = 以击晕长矛扑向敌人、并在不朽怒火中甩开伤口的近乎无敌的战士。

champion-artemis = Artemis
    .title = 狩猎女神
    .lore = 以新月斩跃入战场、标记逃窜猎物并倾泻致命月光箭雨的刺客。

## 北欧

champion-tyr = Tyr
    .title = 法则之神
    .lore = 将单个敌人定身原地、以海量生命和强力自愈坚守的坚毅坦克。

champion-thor = Thor
    .title = 雷霆之神
    .lore = 投掷击晕之锤、冲入战场并召唤减速雷域的风暴战士。

champion-odin = Odin
    .title = 众神之父
    .lore = 射程最远的爆发法师：永不落空的长矛远程击晕，渡鸦划过区域并减速。

champion-loki = Loki
    .title = 诡术师
    .lore = 闪现至标记目标打出全阵容最高爆发、随后以自愈遁走的刺客。

champion-freyja = Freyja
    .title = 华纳神族之女
    .lore = 拥有强力自愈、可缠绕并击晕的技能以及减速隼羽披风的增益型辅助。

champion-ullr = Ullr
    .title = 弓箭之神
    .lore = 以寒霜减速、向区域倾泻箭雨并以滑行位移脱身的远程射手。

## 罗马

champion-mars = Mars
    .title = 战争之神
    .lore = 一位纪律严明的战争战士——以谋略而非蛮怒作战的罗马将军。

champion-vulcan = Vulcan
    .title = 熔炉之父
    .lore = 以熔岩地面掌控空间的熔炉坦克与区域控制者。

champion-bellona = Bellona
    .title = 战争女神
    .lore = 拥有快速远程普攻和一记钉制齐射的武器大师射手。

champion-neptune = Neptune
    .title = 潮汐之主
    .lore = 以重度减速释放远程波浪的脆皮爆发法师。

champion-mercury = Mercury
    .title = 疾速信使
    .lore = 拥有惊人移速、突进爆发与位移脱身的极速刺客。

champion-janus = Janus
    .title = 双面神
    .lore = 提供机动、续航与关门锁定的传送门辅助。

## 埃及

champion-ra-radiant-dawn = Ra
    .title = 灿烂黎明
    .lore = 以大范围日炎新星抹除聚集敌人、并以穿透日矛超远消耗的爆发法师。

champion-anubis-warden-of-scales = Anubis
    .title = 天平守护者
    .lore = 以硬控击晕锁住敌人、并将整片区域压入减速的控制坦克。

champion-horus-skyfall-talon = Horus
    .title = 天陨之爪
    .lore = 以击晕俯冲突进、并以沉重减速打击磨死敌人的战士。

champion-isis-mother-of-magic = Isis
    .title = 魔法之母
    .lore = 建立在巨额自愈、击晕束缚法术和长时间范围减速之上的辅助。

champion-set-lord-of-chaos = Set
    .title = 混沌之主
    .lore = 跃过极远距离在目标身上引爆、随后自愈并溜走的刺客。

champion-bastet-claws-of-the-hunt = Bastet
    .title = 狩猎之爪
    .lore = 以快速普攻撕裂敌人、用减速利爪与九命回复保持风筝的猫科射手。

## 余烬 (Ember)

champion-toran = Toran
    .title = 熔渣守望者
    .lore = 以沉重击晕稳住战局、并以熔炉自愈降温的前排坦克。

champion-vashka = Vashka
    .title = 灰烬之口
    .lore = 以燃烧冲锋拉近距离、用黏性减速与自我续航持续换血的突进战士。

champion-ysmera = Ysmera
    .title = 火葬先知
    .lore = 范围引爆与远程长矛可在一轮内抹除脆皮的脆皮爆发法师。

champion-kaeza = Kaeza
    .title = 余烬锁匠
    .lore = 拥有持续伤害、穿透弩矢和位移小跳的远程射手。

champion-nerreth = Nerreth
    .title = 灰烬潜袭者
    .lore = 闪现至目标、倾泻击晕加爆发连招并脱离战斗的爆发刺客。

## 潮汐 (Tide)

champion-brackmoor = Brackmoor
    .title = 潮汐守望者
    .lore = 拥有硬性冰冻、自我续航和保护队友减速冲击波的前排坦克。

champion-nyxralla = Nyxralla
    .title = 深渊呼唤者
    .lore = 以高倍率长矛与减速绽放引爆目标的脆皮远程爆发法师。

champion-cyranth = Cyranth
    .title = 暗礁潜猎者
    .lore = 拥有高持续伤害、重击技能和单体减速以便风筝的射手。

champion-veyl = Veyl
    .title = 暗涌
    .lore = 拥有拉近距离的突进爆发与锁定处决的刺客——脆皮但灵活。

champion-lumisel = Lumisel
    .title = 潮汐歌者
    .lore = 拥有两种不同强度治疗和一片减速消耗区域以保护队友的增益型辅助。

## 翠绿 (Verdant)

champion-mosscloak = Mosscloak
    .title = 林地守望者
    .lore = 吸收伤害、定身单个威胁并重新长出树皮的前排坦克。

champion-gorehoof = Gorehoof
    .title = 血根
    .lore = 冲撞时使敌人踉跄、换血并畅饮血根以留在战斗中的突进战士。

champion-sporeveil = Sporeveil
    .title = 腐朽之花
    .lore = 引爆孢子绽放、以花粉窒息区域并狙杀落单者的脆皮爆发法师。

champion-thornquill = Thornquill
    .title = 荆棘守望
    .lore = 倾泻成长型倒刺、以穿透尖刺致残并弹跳拉开距离的射手。

champion-petalsong = Petalsong
    .title = 花语歌者
    .lore = 锁定关键目标、以缠绕藤蔓窒息群体并以歌声愈合自身伤口的扰乱型辅助。

## 暗影 (Umbral)

champion-dregmaw = Dregmaw
    .title = 暮光壁垒
    .lore = 与蚀铁融为一体、吸收惩罚、以暗影之握束缚威胁并在阴影中愈合的前排坦克。

champion-korrathil = Korrathil
    .title = 虚空吞噬者
    .lore = 砸向猎物、将其钳制原地并持续吞噬直至自身伤口愈合的突进战士。

champion-xelphine = Xelphine
    .title = 蚀日先知
    .lore = 在脚下绽放暗影、长矛穿刺远处猎物并召唤彻底黑夜的脆皮爆发法师。

champion-quorvane = Quorvane
    .title = 夜玻璃猎手
    .lore = 从视野边缘射出虚空玻璃碎片、以穿透弹钉住逃窜猎物的耐心射手。

champion-zeryth = Zeryth
    .title = 暗影之牙
    .lore = 由活体暗影构成、折叠与目标的距离、在其尖叫中将其钉住并在黑暗中终结的爆发刺客。
