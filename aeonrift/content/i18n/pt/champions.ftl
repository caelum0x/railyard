# Aeonrift — Localização de campeões (pt)
#
# Nomes próprios (nomes de campeões) permanecem intencionalmente idênticos ao original.
# São traduzidos os títulos (.title) e a descrição de uma linha (.lore).
# Os slugs correspondem exatamente a content/champions/*.ron.

## Base

champion-sentinel = Sentinel
    .title = A Referência
    .lore = Um atacante automático puro, com ataques básicos confiáveis e contundentes e uma modesta autocura — a medida de todos os outros.

champion-pyromancer = Pyromancer
    .title = O Conjurador de Brasas
    .lore = Um mago de dano explosivo centrado em uma bola de fogo de longo alcance que supera atacantes automáticos e atordoa antes que possam se aproximar.

champion-vanguard = Vanguard
    .title = O Quebra-Ferro
    .lore = Um brigão que avança sobre um alvo, golpeia com dano pesado e atordoa brevemente — um engajamento clássico.

## Gregos

champion-zeus = Zeus
    .title = Rei do Olimpo
    .lore = Um mago de dano explosivo que invoca um raio de longo alcance que atordoa, apoiado por uma tempestade que causa dano e reduz a velocidade.

champion-hades = Hades
    .title = Senhor do Submundo
    .lore = Um tanque controlador do vazio que arrasta um inimigo com um atordoamento, cobre o chão com fogo de almas e se alimenta dos mortos.

champion-athena = Athena
    .title = Deusa da Sabedoria
    .lore = Uma suporte guardiã que se protege com escudo, prende inimigos com uma coruja lentificante e comanda uma falange atordoante.

champion-medusa = Medusa
    .title = A Górgona
    .lore = Uma atiradora cujo olhar petrificante transforma um alvo em pedra, apoiada por um disparo de veneno que reduz a velocidade.

champion-achilles = Achilles
    .title = Herói de Troia
    .lore = Um brigão quase invencível que mergulha sobre um inimigo com uma lança atordoante e ignora ferimentos num acesso de fúria imortal.

champion-artemis = Artemis
    .title = Deusa da Caça
    .lore = Uma assassina que salta com um golpe crescente, marca presas em fuga e dispara uma saraivada mortal de luar.

## Nórdicos

champion-tyr = Tyr
    .title = Deus da Lei
    .lore = Um tanque resoluto que prende um único inimigo no lugar e resiste com vida imensa e forte autossustento.

champion-thor = Thor
    .title = Deus do Trovão
    .lore = Um brigão da tempestade que arremessa um martelo atordoante, avança e invoca uma área de trovão que reduz a velocidade.

champion-odin = Odin
    .title = O Pai de Todos
    .lore = Um mago de dano explosivo e longo alcance cuja lança infalível atordoa à distância enquanto seus corvos dilaceram uma área e reduzem a velocidade.

champion-loki = Loki
    .title = O Trapaceiro
    .lore = Um assassino que se teletransporta até uma marca para o maior dano explosivo do elenco e depois desaparece com uma autocura.

champion-freyja = Freyja
    .title = Senhora dos Vanir
    .lore = Uma suporte encantadora com uma grande autocura, um disparo de habilidade que prende e atordoa, e um manto de falcão que reduz a velocidade.

champion-ullr = Ullr
    .title = Deus do Arco
    .lore = Um atirador de longo alcance que reduz a velocidade com gelo, faz chover uma saraivada sobre uma área e desliza para longe com um avanço de reposicionamento.

## Romanos

champion-mars = Mars
    .title = Deus da Guerra
    .lore = Um brigão de guerra disciplinado — um general romano que luta com método, não com fúria bruta.

champion-vulcan = Vulcan
    .title = O Pai da Forja
    .lore = Um tanque da forja e controlador de espaço que domina o terreno com chão derretido.

champion-bellona = Bellona
    .title = Deusa da Guerra
    .lore = Uma atiradora mestra das armas com ataques automáticos rápidos e de longo alcance e uma saraivada que imobiliza.

champion-neptune = Neptune
    .title = Senhor das Marés
    .lore = Um mago de dano explosivo e frágil que desencadeia ondas de longo alcance com fortes reduções de velocidade.

champion-mercury = Mercury
    .title = O Portador da Rapidez
    .lore = Um assassino da velocidade com velocidade de movimento fulminante, um dano explosivo de entrada e um avanço de fuga.

champion-janus = Janus
    .title = O de Duas Faces
    .lore = Um suporte de portais que oferece mobilidade, sustento e um travamento com o bater de um portal.

## Egípcios

champion-ra-radiant-dawn = Ra
    .title = Aurora Radiante
    .lore = Um mago de dano explosivo que apaga inimigos agrupados com uma ampla nova de fogo solar e assedia com uma lança solar perfurante.

champion-anubis-warden-of-scales = Anubis
    .title = Guardião das Balanças
    .lore = Um tanque de controle que prende inimigos com um atordoamento forte e esmaga uma área inteira em uma lentidão.

champion-horus-skyfall-talon = Horus
    .title = Garra da Queda Celeste
    .lore = Um brigão que mergulha com um avanço de falcão atordoante e desgasta inimigos com golpes pesados que reduzem a velocidade.

champion-isis-mother-of-magic = Isis
    .title = Mãe da Magia
    .lore = Uma suporte construída sobre uma enorme autocura, um feitiço de amarração atordoante e uma longa lentidão em área.

champion-set-lord-of-chaos = Set
    .title = Senhor do Caos
    .lore = Um assassino que salta uma distância enorme para detonar sobre um alvo, depois se cura e escapa.

champion-bastet-claws-of-the-hunt = Bastet
    .title = Garras da Caça
    .lore = Uma atiradora felina cujos ataques básicos rápidos rasgam os inimigos, driblando com uma garra lentificante e uma recuperação de nove vidas.

## Ember

champion-toran = Toran
    .title = O Guardião da Escória
    .lore = Um tanque de linha de frente que ancora os combates com um atordoamento pesado e se resfria com uma cura alimentada pela forja.

champion-vashka = Vashka
    .title = Fauce de Brasa
    .lore = Um brigão mergulhador que fecha a distância com uma investida ardente e troca golpes com lentidões grudentas e autossustento.

champion-ysmera = Ysmera
    .title = A Oráculo da Pira
    .lore = Uma maga de dano explosivo e frágil cujas detonações em área e lança de longo alcance apagam os frágeis em uma única rotação.

champion-kaeza = Kaeza
    .title = A Trava de Brasa
    .lore = Uma atiradora à distância com dano contínuo, um projétil perfurante e um salto de reposicionamento.

champion-nerreth = Nerreth
    .title = O Espreitador das Cinzas
    .lore = Um assassino de dano explosivo que se teletransporta sobre um alvo, despeja um combo de atordoamento e explosão e se desengaja.

## Tide

champion-brackmoor = Brackmoor
    .title = O Guardião das Marés
    .lore = Um tanque de linha de frente com um congelamento forte, autossustento e uma onda de choque lentificante para proteger os aliados.

champion-nyxralla = Nyxralla
    .title = A Chamadora das Profundezas
    .lore = Uma maga de dano explosivo, frágil e de longo alcance que detona alvos com uma lança de alta escala e um florescer lentificante.

champion-cyranth = Cyranth
    .title = O Espreitador dos Recifes
    .lore = Um atirador com alto dano contínuo, um disparo de habilidade contundente e uma lentidão de alvo único para driblar.

champion-veyl = Veyl
    .title = A Ressaca
    .lore = Um assassino com uma explosão em avanço que fecha a distância e uma execução de travamento — frágil, mas ágil.

champion-lumisel = Lumisel
    .title = A Cantora das Marés
    .lore = Uma suporte encantadora com duas curas de pesos diferentes e uma zona lentificante de dano contínuo para proteção.

## Verdant

champion-mosscloak = Mosscloak
    .title = O Guardião do Bosque
    .lore = Um tanque de linha de frente que absorve dano, enraíza uma única ameaça e faz sua própria casca crescer novamente.

champion-gorehoof = Gorehoof
    .title = A Raiz de Sangue
    .lore = Um brigão mergulhador que cambaleia os inimigos ao impacto, troca golpes e bebe da raiz de sangue para permanecer no combate.

champion-sporeveil = Sporeveil
    .title = A Flor da Podridão
    .lore = Uma maga de dano explosivo e frágil que detona um florescer de esporos, sufoca uma zona com pólen e abate os retardatários.

champion-thornquill = Thornquill
    .title = A Vigília dos Espinhos
    .lore = Um atirador que faz chover farpas escaláveis, incapacita com um espinho perfurante e salta para longe para manter distância.

champion-petalsong = Petalsong
    .title = A Cantora das Flores
    .lore = Uma suporte perturbadora que trava um alvo-chave, sufoca um grupo com trepadeiras agarradoras e canta o fechar de suas feridas.

## Umbral

champion-dregmaw = Dregmaw
    .title = O Baluarte do Crepúsculo
    .lore = Um tanque de linha de frente fundido a ferro-eclipse que absorve o castigo, acorrenta uma ameaça com um aperto umbral e se cura na sombra.

champion-korrathil = Korrathil
    .title = O Devorador do Vazio
    .lore = Um brigão mergulhador que despenca sobre a presa, a prende no lugar e se alimenta até que suas próprias feridas se fechem.

champion-xelphine = Xelphine
    .title = A Vidente do Eclipse
    .lore = Uma maga de dano explosivo e frágil que faz florescer sombras a seus pés, perfura presas distantes e invoca um anoitecer total.

champion-quorvane = Quorvane
    .title = Caçador de Vidro Noturno
    .lore = Um atirador paciente que dispara estilhaços de vidro do vazio da borda da visão e prende presas em fuga com um disparo perfurante.

champion-zeryth = Zeryth
    .title = A Presa Umbral
    .lore = Um assassino de dano explosivo feito de sombra viva que dobra a distância até uma marca, a prende em meio ao grito e a finaliza na escuridão.
