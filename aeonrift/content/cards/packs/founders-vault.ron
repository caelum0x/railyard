// A one-time premium vault for founders, floor Epic.
CardPack(
    id: "founders-vault",
    name: "Founder's Vault",
    description: "A one-time premium vault for founders, floor Epic.",
    category: "premium",
    card_count: 12,
    cost: PackCost(currency: "gems", amount: 900),
    one_time: true,
    guaranteed_floor: Some("epic"),
    rarity_odds: [
        RarityOdd(rarity: "common",    weight: 300),
        RarityOdd(rarity: "uncommon",  weight: 300),
        RarityOdd(rarity: "rare",      weight: 240),
        RarityOdd(rarity: "epic",      weight: 110),
        RarityOdd(rarity: "legendary", weight: 40),
        RarityOdd(rarity: "mythic",    weight: 10),
    ],
)
