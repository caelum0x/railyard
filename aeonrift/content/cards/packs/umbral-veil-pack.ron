    guaranteed_floor: Some("rare"),
    faction_bias: Some("Umbral"),
    rarity_odds: [
        RarityOdd(rarity: "common",    weight: 500),
        RarityOdd(rarity: "uncommon",  weight: 300),
        RarityOdd(rarity: "rare",      weight: 150),
        RarityOdd(rarity: "epic",      weight: 42),
        RarityOdd(rarity: "legendary", weight: 7),
        RarityOdd(rarity: "mythic",    weight: 1),
    ],
