    rarity_odds: [
        RarityOdd(rarity: "common",    weight: 180),
        RarityOdd(rarity: "uncommon",  weight: 250),
        RarityOdd(rarity: "rare",      weight: 280),
        RarityOdd(rarity: "epic",      weight: 200),
        RarityOdd(rarity: "legendary", weight: 78),
        RarityOdd(rarity: "mythic",    weight: 12),
    ],
)
