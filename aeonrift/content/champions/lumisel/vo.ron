// Voice-line manifest for Lumisel: stable ids -> future audio refs.
// The `audio` paths point into the content-addressed asset store and are
// resolved later; `text` is placeholder subtitle copy. Data only.
VoiceLines(
    slug: "lumisel",
    locale: "en",
    lines: [
        VoiceLine(
            id: "vo.lumisel.select",
            kind: "Selected",
            audio: "audio/vo/lumisel/select.ogg",
            text: "Lumisel answers the call.",
        ),
        VoiceLine(
            id: "vo.lumisel.move_a",
            kind: "Move",
            audio: "audio/vo/lumisel/move_a.ogg",
            text: "On my way.",
        ),
        VoiceLine(
            id: "vo.lumisel.move_b",
            kind: "Move",
            audio: "audio/vo/lumisel/move_b.ogg",
            text: "It shall be done.",
        ),
        VoiceLine(
            id: "vo.lumisel.attack_a",
            kind: "Attack",
            audio: "audio/vo/lumisel/attack_a.ogg",
            text: "Face me.",
        ),
        VoiceLine(
            id: "vo.lumisel.attack_b",
            kind: "Attack",
            audio: "audio/vo/lumisel/attack_b.ogg",
            text: "You chose poorly.",
        ),
        VoiceLine(
            id: "vo.lumisel.ability_q",
            kind: "Ability: Tidal Blessing",
            audio: "audio/vo/lumisel/ability_q.ogg",
            text: "Tidal Blessing!",
        ),
        VoiceLine(
            id: "vo.lumisel.ability_w",
            kind: "Ability: Frostwater Veil",
            audio: "audio/vo/lumisel/ability_w.ogg",
            text: "Frostwater Veil!",
        ),
        VoiceLine(
            id: "vo.lumisel.ability_r",
            kind: "Ability: Riptide Ward",
            audio: "audio/vo/lumisel/ability_r.ogg",
            text: "Riptide Ward!",
        ),
        VoiceLine(
            id: "vo.lumisel.taunt",
            kind: "Taunt",
            audio: "audio/vo/lumisel/taunt.ogg",
            text: "Is that all you bring?",
        ),
        VoiceLine(
            id: "vo.lumisel.joke",
            kind: "Joke",
            audio: "audio/vo/lumisel/joke.ogg",
            text: "Even legends need a moment.",
        ),
        VoiceLine(
            id: "vo.lumisel.low_health",
            kind: "Low health",
            audio: "audio/vo/lumisel/low_health.ogg",
            text: "I am wounded, not beaten.",
        ),
        VoiceLine(
            id: "vo.lumisel.victory",
            kind: "Victory",
            audio: "audio/vo/lumisel/victory.ogg",
            text: "The field is ours.",
        ),
    ],
)
