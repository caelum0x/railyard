    slug: "ra-radiant-dawn",
    archetype: "mage",
    base: LevelStats(hp: 480, ad: 30, armor: 18, attack_speed: 0.75),
    per_level: StatGrowth(hp: 70, ad: 3.0, armor: 2.2, attack_speed: 0.018),
    levels: [
