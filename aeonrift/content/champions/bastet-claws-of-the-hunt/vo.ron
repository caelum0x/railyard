        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.low_health",
            kind: "Low health",
            audio: "audio/vo/bastet-claws-of-the-hunt/low_health.ogg",
            text: "I am wounded, not beaten.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.victory",
            kind: "Victory",
            audio: "audio/vo/bastet-claws-of-the-hunt/victory.ogg",
            text: "The field is ours.",
