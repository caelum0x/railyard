// Voice-line manifest for Bastet: stable ids -> future audio refs.
// The `audio` paths point into the content-addressed asset store and are
// resolved later; `text` is placeholder subtitle copy. Data only.
VoiceLines(
    slug: "bastet-claws-of-the-hunt",
    locale: "en",
    lines: [
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.select",
