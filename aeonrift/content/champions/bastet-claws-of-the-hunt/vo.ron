            text: "Bastet answers the call.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.move_a",
            kind: "Move",
            audio: "audio/vo/bastet-claws-of-the-hunt/move_a.ogg",
            text: "On my way.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.move_b",
            kind: "Move",
            audio: "audio/vo/bastet-claws-of-the-hunt/move_b.ogg",
            text: "It shall be done.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.attack_a",
            kind: "Attack",
            audio: "audio/vo/bastet-claws-of-the-hunt/attack_a.ogg",
            text: "Face me.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.attack_b",
            kind: "Attack",
            audio: "audio/vo/bastet-claws-of-the-hunt/attack_b.ogg",
            text: "You chose poorly.",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.ability_q",
            kind: "Ability: Pounce",
            audio: "audio/vo/bastet-claws-of-the-hunt/ability_q.ogg",
            text: "Pounce!",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.ability_w",
            kind: "Ability: Rending Claws",
            audio: "audio/vo/bastet-claws-of-the-hunt/ability_w.ogg",
            text: "Rending Claws!",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.ability_r",
            kind: "Ability: Feral Frenzy",
            audio: "audio/vo/bastet-claws-of-the-hunt/ability_r.ogg",
            text: "Feral Frenzy!",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.taunt",
            kind: "Taunt",
            audio: "audio/vo/bastet-claws-of-the-hunt/taunt.ogg",
            text: "Is that all you bring?",
        ),
        VoiceLine(
            id: "vo.bastet_claws_of_the_hunt.joke",
