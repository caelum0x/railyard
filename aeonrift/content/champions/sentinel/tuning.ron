// Per-rank ability tuning for Sentinel.
// Numbers are authored knobs for the balance pass; rank 1 mirrors the
// flat loadable spec (content/champions/sentinel.ron), higher ranks scale up
// damage/heal while trimming cooldown. Consumed by the balance tooling,
// never by the ability-dsl loader (which globs *.ron in the root only).
ChampionTuning(
    slug: "sentinel",
    display_name: "Sentinel",
    abilities: [
        AbilityTuning(
            name: "Second Wind",
            slot: "Q",
            max_rank: 5,
            ranks: [
                Rank(rank: 1, cooldown: 150, cost: None, damage: None, ad_ratio: None, heal: Some(90), cc: None),
                Rank(rank: 2, cooldown: 142, cost: None, damage: None, ad_ratio: None, heal: Some(112), cc: None),
                Rank(rank: 3, cooldown: 135, cost: None, damage: None, ad_ratio: None, heal: Some(135), cc: None),
                Rank(rank: 4, cooldown: 128, cost: None, damage: None, ad_ratio: None, heal: Some(158), cc: None),
                Rank(rank: 5, cooldown: 120, cost: None, damage: None, ad_ratio: None, heal: Some(180), cc: None),
            ],
        ),
    ],
)
