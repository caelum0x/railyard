// Kaeza — the EMBERLOCK, a ranged marksman.
//
// Sustained ranged DPS with a piercing bolt and a repositioning hop. High
// auto-attack range, thin defenses. Authored as DATA only.
ChampionSpec(
    name: "Kaeza",
    base: BaseStats(
        hp: 560,
        ad: 56,
        armor: 22,
        attack_speed: 1.1,
        move_speed: 11.0,
        range: 25.0,
    ),
    abilities: [
        // Scorch Bolt: piercing skillshot, scales hard with AD.
        AbilitySpec(
            name: "Scorch Bolt",
            cooldown: 90,
            cost: Some(40),
            targeting: Skillshot,
            range: 30.0,
            effects: [
                Damage(amount: 70, scaling: Some(AttackDamage(ratio: 1.0))),
            ],
        ),
        // Ashstep: short dash to kite and reposition.
        AbilitySpec(
            name: "Ashstep",
            cooldown: 150,
            cost: Some(35),
            targeting: Skillshot,
            range: 14.0,
            effects: [ Dash(distance: 14.0) ],
        ),
        // Slagshot: heavy single-target round with a slow.
        AbilitySpec(
            name: "Slagshot",
            cooldown: 300,
            cost: Some(80),
            targeting: Target,
            range: 26.0,
            effects: [
                Damage(amount: 140, scaling: Some(AttackDamage(ratio: 1.0))),
                Slow(duration: 60),
            ],
        ),
    ],
)
