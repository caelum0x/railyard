    slug: "horus-skyfall-talon",
    archetype: "bruiser",
    base: LevelStats(hp: 720, ad: 31, armor: 32, attack_speed: 0.9),
    per_level: StatGrowth(hp: 92, ad: 3.6, armor: 3.4, attack_speed: 0.025),
    levels: [
