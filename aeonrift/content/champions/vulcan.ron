// Vulcan — the forge TANK / zoner. Durable frontline that controls space with molten ground.
ChampionSpec(
    name: "Vulcan",
    base: BaseStats(
        hp: 860,
        ad: 42,
        armor: 40,
        attack_speed: 0.8,
        move_speed: 9.5,
        range: 5.0,
    ),
    abilities: [
        // Slam the anvil: molten zone that damages and slows.
        AbilitySpec(
            name: "Molten Anvil",
            cooldown: 70,
            cost: Some(50),
            targeting: Area,
            range: 11.0,
            effects: [
                Damage(amount: 55, scaling: Some(AttackDamage(ratio: 0.3))),
                Slow(duration: 45),
            ],
        ),
        // Forge-chains snare a runner.
        AbilitySpec(
            name: "Cinder Chains",
            cooldown: 110,
            cost: Some(40),
            targeting: Skillshot,
            range: 20.0,
            effects: [
                Damage(amount: 40, scaling: Some(AttackDamage(ratio: 0.2))),
                Stun(duration: 10),
            ],
        ),
        // Temper armor at the forge.
        AbilitySpec(
            name: "Forge Ward",
            cooldown: 150,
            cost: None,
            targeting: SelfCast,
            effects: [ Heal(amount: 130) ],
        ),
    ],
)
