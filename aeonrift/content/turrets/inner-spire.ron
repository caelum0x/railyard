// Inner Warding Spire — the second turret tier. Tankier than the Outer Spire and
// hits harder, but has no armour plating (plating is an outer-tier mechanic). Only
// becomes attackable once the lane's Outer Spire has fallen. Placements in the map.
TurretSpec(
    id: "inner_spire",
    display_name: "Inner Warding Spire",
    tier: "Inner",

    stats: TurretStats(
        hp: 5500,
        armor: 55,
        magic_resist: 55,
        attack_damage: 170,
        attack_speed: 0.83,
        attack_range: 15.0,
    ),

    // Gated behind the Outer Spire in the same lane.
    unlock: (requires_destroyed: "outer_spire", scope: "SameLane"),

    heat_ramp: (max_stacks: 3, bonus_per_stack_percent: 40, decay_seconds: 4),

    bounty: (gold_local: 250, gold_global: 125),

    targeting:  "spire_targeting",
    projectile: "spire_projectile",
)
