// Riftling Colossus — the super minion. Spawns for a team once it has destroyed an
// enemy inhibitor (Rift Conduit); one joins each wave in that lane until the conduit
// respawns. Enormous HP, high damage, strong structure damage, resistant to magic.
// Base stats at 0:00; growth via minion-scaling.ron.
MinionSpec(
    id: "super_minion",
    display_name: "Riftling Colossus",
    class: "Super",
    count_per_wave: 1,        // one per wave while the enemy conduit is down
    collision_radius: 0.85,

    base: MinionStats(
        hp: 1600,
        ad: 190,
        armor: 30,
        magic_resist: 30,     // hardened against spell chip
        attack_speed: 0.85,
        move_speed: 13.0,
        attack_range: 2.0,
        attack_type: Physical,
    ),

    structure_damage_multiplier: 1.5,

    // Super minions passively regenerate to shrug off harass.
    hp_regen_per_second: 15,

    bounty: (gold_last_hit: 60, gold_shared: 0, xp: 92),

    aggro_priority: [
        "EnemyStructure",
        "EnemyMinionAttackingAlly",
        "NearestEnemyMinion",
        "NearestEnemyChampion",
    ],

    ai: "minion_ai_behavior",
    scaling: "minion_scaling",
)
