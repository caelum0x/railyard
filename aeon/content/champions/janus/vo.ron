// Voice-line manifest for Janus: stable ids -> future audio refs.
// The `audio` paths point into the content-addressed asset store and are
// resolved later; `text` is placeholder subtitle copy. Data only.
VoiceLines(
    slug: "janus",
    locale: "en",
    lines: [
        VoiceLine(
            id: "vo.janus.select",
            kind: "Selected",
            audio: "audio/vo/janus/select.ogg",
            text: "Janus answers the call.",
        ),
        VoiceLine(
            id: "vo.janus.move_a",
            kind: "Move",
            audio: "audio/vo/janus/move_a.ogg",
            text: "On my way.",
        ),
        VoiceLine(
            id: "vo.janus.move_b",
            kind: "Move",
            audio: "audio/vo/janus/move_b.ogg",
            text: "It shall be done.",
        ),
        VoiceLine(
            id: "vo.janus.attack_a",
            kind: "Attack",
            audio: "audio/vo/janus/attack_a.ogg",
            text: "Face me.",
        ),
        VoiceLine(
            id: "vo.janus.attack_b",
            kind: "Attack",
            audio: "audio/vo/janus/attack_b.ogg",
            text: "You chose poorly.",
        ),
        VoiceLine(
            id: "vo.janus.ability_q",
            kind: "Ability: Closing Door",
            audio: "audio/vo/janus/ability_q.ogg",
            text: "Closing Door!",
        ),
        VoiceLine(
            id: "vo.janus.ability_w",
            kind: "Ability: Gate of Passage",
            audio: "audio/vo/janus/ability_w.ogg",
            text: "Gate of Passage!",
        ),
        VoiceLine(
            id: "vo.janus.ability_r",
            kind: "Ability: Threshold Ward",
            audio: "audio/vo/janus/ability_r.ogg",
            text: "Threshold Ward!",
        ),
        VoiceLine(
            id: "vo.janus.taunt",
            kind: "Taunt",
            audio: "audio/vo/janus/taunt.ogg",
            text: "Is that all you bring?",
        ),
        VoiceLine(
            id: "vo.janus.joke",
            kind: "Joke",
            audio: "audio/vo/janus/joke.ogg",
            text: "Even legends need a moment.",
        ),
        VoiceLine(
            id: "vo.janus.low_health",
            kind: "Low health",
            audio: "audio/vo/janus/low_health.ogg",
            text: "I am wounded, not beaten.",
        ),
        VoiceLine(
            id: "vo.janus.victory",
            kind: "Victory",
            audio: "audio/vo/janus/victory.ogg",
            text: "The field is ours.",
        ),
    ],
)
