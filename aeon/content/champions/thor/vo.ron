// Voice-line manifest for Thor: stable ids -> future audio refs.
// The `audio` paths point into the content-addressed asset store and are
// resolved later; `text` is placeholder subtitle copy. Data only.
VoiceLines(
    slug: "thor",
    locale: "en",
    lines: [
        VoiceLine(
            id: "vo.thor.select",
            kind: "Selected",
            audio: "audio/vo/thor/select.ogg",
            text: "Thor answers the call.",
        ),
        VoiceLine(
            id: "vo.thor.move_a",
            kind: "Move",
            audio: "audio/vo/thor/move_a.ogg",
            text: "On my way.",
        ),
        VoiceLine(
            id: "vo.thor.move_b",
            kind: "Move",
            audio: "audio/vo/thor/move_b.ogg",
            text: "It shall be done.",
        ),
        VoiceLine(
            id: "vo.thor.attack_a",
            kind: "Attack",
            audio: "audio/vo/thor/attack_a.ogg",
            text: "Face me.",
        ),
        VoiceLine(
            id: "vo.thor.attack_b",
            kind: "Attack",
            audio: "audio/vo/thor/attack_b.ogg",
            text: "You chose poorly.",
        ),
        VoiceLine(
            id: "vo.thor.ability_q",
            kind: "Ability: Mjolnir Hurl",
            audio: "audio/vo/thor/ability_q.ogg",
            text: "Mjolnir Hurl!",
        ),
        VoiceLine(
            id: "vo.thor.ability_w",
            kind: "Ability: Thunder Charge",
            audio: "audio/vo/thor/ability_w.ogg",
            text: "Thunder Charge!",
        ),
        VoiceLine(
            id: "vo.thor.ability_r",
            kind: "Ability: God of Thunder",
            audio: "audio/vo/thor/ability_r.ogg",
            text: "God of Thunder!",
        ),
        VoiceLine(
            id: "vo.thor.taunt",
            kind: "Taunt",
            audio: "audio/vo/thor/taunt.ogg",
            text: "Is that all you bring?",
        ),
        VoiceLine(
            id: "vo.thor.joke",
            kind: "Joke",
            audio: "audio/vo/thor/joke.ogg",
            text: "Even legends need a moment.",
        ),
        VoiceLine(
            id: "vo.thor.low_health",
            kind: "Low health",
            audio: "audio/vo/thor/low_health.ogg",
            text: "I am wounded, not beaten.",
        ),
        VoiceLine(
            id: "vo.thor.victory",
            kind: "Victory",
            audio: "audio/vo/thor/victory.ogg",
            text: "The field is ours.",
        ),
    ],
)
