// Voice-line manifest for Horus: stable ids -> future audio refs.
// The `audio` paths point into the content-addressed asset store and are
// resolved later; `text` is placeholder subtitle copy. Data only.
VoiceLines(
    slug: "horus-skyfall-talon",
    locale: "en",
    lines: [
        VoiceLine(
            id: "vo.horus_skyfall_talon.select",
            kind: "Selected",
            audio: "audio/vo/horus-skyfall-talon/select.ogg",
            text: "Horus answers the call.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.move_a",
            kind: "Move",
            audio: "audio/vo/horus-skyfall-talon/move_a.ogg",
            text: "On my way.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.move_b",
            kind: "Move",
            audio: "audio/vo/horus-skyfall-talon/move_b.ogg",
            text: "It shall be done.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.attack_a",
            kind: "Attack",
            audio: "audio/vo/horus-skyfall-talon/attack_a.ogg",
            text: "Face me.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.attack_b",
            kind: "Attack",
            audio: "audio/vo/horus-skyfall-talon/attack_b.ogg",
            text: "You chose poorly.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.ability_q",
            kind: "Ability: Falcon Dive",
            audio: "audio/vo/horus-skyfall-talon/ability_q.ogg",
            text: "Falcon Dive!",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.ability_w",
            kind: "Ability: Talon Rend",
            audio: "audio/vo/horus-skyfall-talon/ability_w.ogg",
            text: "Talon Rend!",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.ability_r",
            kind: "Ability: War Cry",
            audio: "audio/vo/horus-skyfall-talon/ability_r.ogg",
            text: "War Cry!",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.taunt",
            kind: "Taunt",
            audio: "audio/vo/horus-skyfall-talon/taunt.ogg",
            text: "Is that all you bring?",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.joke",
            kind: "Joke",
            audio: "audio/vo/horus-skyfall-talon/joke.ogg",
            text: "Even legends need a moment.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.low_health",
            kind: "Low health",
            audio: "audio/vo/horus-skyfall-talon/low_health.ogg",
            text: "I am wounded, not beaten.",
        ),
        VoiceLine(
            id: "vo.horus_skyfall_talon.victory",
            kind: "Victory",
            audio: "audio/vo/horus-skyfall-talon/victory.ogg",
            text: "The field is ours.",
        ),
    ],
)
