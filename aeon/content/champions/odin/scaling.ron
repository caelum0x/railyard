        LevelRow(level: 7, hp: 920, ad: 48, armor: 33, attack_speed: 0.858),
        LevelRow(level: 8, hp: 990, ad: 51, armor: 35, attack_speed: 0.876),
        LevelRow(level: 9, hp: 1060, ad: 54, armor: 38, attack_speed: 0.894),
