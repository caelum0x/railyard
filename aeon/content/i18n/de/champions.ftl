# Aeonrift — Champion-Lokalisierung (de)
#
# Eigennamen (Champion-Namen) bleiben absichtlich identisch zum Original.
# Übersetzt werden Titel (.title) und die einzeilige Beschreibung (.lore).
# Die Slugs stimmen exakt mit content/champions/*.ron überein.

## Basis

champion-sentinel = Sentinel
    .title = Der Maßstab
    .lore = Ein reiner Auto-Angreifer mit verlässlichen, harten Grundangriffen und bescheidener Selbstheilung — der Maßstab für alle anderen.

champion-pyromancer = Pyromancer
    .title = Der Glutrufer
    .lore = Ein Burst-Magier rund um einen weitreichenden Feuerball, der Schützen überreicht und betäubt, bevor sie herankommen.

champion-vanguard = Vanguard
    .title = Der Eisenbrecher
    .lore = Ein Kämpfer, der auf ein Ziel zuprescht, hart zuschlägt und kurz betäubt — ein klassischer Angriffsauftakt.

## Griechen

champion-zeus = Zeus
    .title = König des Olymp
    .lore = Ein Burst-Magier, der einen weitreichenden Blitz herabruft, der betäubt, gestützt von einem Sturm, der Schaden zufügt und verlangsamt.

champion-hades = Hades
    .title = Herr der Unterwelt
    .lore = Ein Void-Kontroll-Tank, der einen Gegner mit einer Betäubung heranzieht, den Boden mit Seelenfeuer bedeckt und sich von den Toten nährt.

champion-athena = Athena
    .title = Göttin der Weisheit
    .lore = Eine beschützende Unterstützerin, die sich selbst abschirmt, Gegner mit einer verlangsamenden Eule fängt und eine betäubende Phalanx befehligt.

champion-medusa = Medusa
    .title = Die Gorgone
    .lore = Eine Schützin, deren versteinernder Blick ein Ziel zu Stein macht, gestützt von einem Giftschuss, der verlangsamt.

champion-achilles = Achilles
    .title = Held von Troja
    .lore = Ein nahezu unbesiegbarer Kämpfer, der sich mit einem betäubenden Speer auf einen Feind stürzt und Wunden in einem Ausbruch unsterblicher Wut abschüttelt.

champion-artemis = Artemis
    .title = Göttin der Jagd
    .lore = Eine Assassine, die mit einem Sichelhieb hereinspringt, fliehende Beute markiert und eine tödliche Salve aus Mondlicht abfeuert.

## Nordische

champion-tyr = Tyr
    .title = Gott des Rechts
    .lore = Ein standhafter Tank, der einen einzelnen Feind an Ort und Stelle bindet und mit gewaltiger Lebenskraft und starker Selbstheilung durchhält.

champion-thor = Thor
    .title = Gott des Donners
    .lore = Ein Sturmkämpfer, der einen betäubenden Hammer wirft, hineinstürmt und ein verlangsamendes Donnerfeld herbeiruft.

champion-odin = Odin
    .title = Der Allvater
    .lore = Ein weitreichender Burst-Magier, dessen nie verfehlender Speer aus der Ferne betäubt, während seine Raben ein Gebiet durchschneiden und verlangsamen.

champion-loki = Loki
    .title = Der Trickster
    .lore = Ein Assassine, der zu einem Ziel blinzelt für den höchsten Burst des Kaders und dann mit einer Selbstheilung verschwindet.

champion-freyja = Freyja
    .title = Herrin der Wanen
    .lore = Eine Verzauberer-Unterstützerin mit großer Selbstheilung, einem fangenden Skillshot, der betäubt, und einem verlangsamenden Falkenmantel.

champion-ullr = Ullr
    .title = Gott des Bogens
    .lore = Ein weitreichender Schütze, der mit Frost verlangsamt, eine Salve über ein Gebiet regnen lässt und sich mit einem Repositionierungs-Dash davonschlittert.

## Römer

champion-mars = Mars
    .title = Gott des Krieges
    .lore = Ein disziplinierter Kriegskämpfer — ein römischer Feldherr, der mit Methode kämpft, nicht mit roher Wut.

champion-vulcan = Vulcan
    .title = Der Schmiedevater
    .lore = Ein Schmiede-Tank und Zonen-Kontrolleur, der mit geschmolzenem Boden den Raum beherrscht.

champion-bellona = Bellona
    .title = Göttin des Krieges
    .lore = Eine waffenmeisterliche Schützin mit schnellen, weitreichenden Auto-Angriffen und einer festnagelnden Salve.

champion-neptune = Neptune
    .title = Herr der Gezeiten
    .lore = Ein zerbrechlicher Burst-Magier, der weitreichende Wellen mit heftigen Verlangsamungen entfesselt.

champion-mercury = Mercury
    .title = Der Flinke Bote
    .lore = Ein Tempo-Assassine mit atemberaubendem Lauftempo, einem Einstiegs-Burst und einem Ausstiegs-Dash.

champion-janus = Janus
    .title = Der Zweigesichtige
    .lore = Ein Portal-Unterstützer, der Mobilität, Beständigkeit und eine Tor-zuschlagende Festsetzung bietet.

## Ägypter

champion-ra-radiant-dawn = Ra
    .title = Strahlendes Morgenrot
    .lore = Ein Burst-Magier, der geballte Feinde mit einer breiten Sonnenfeuer-Nova auslöscht und mit einer durchbohrenden Sonnenlanze aus der Distanz zusetzt.

champion-anubis-warden-of-scales = Anubis
    .title = Wächter der Waage
    .lore = Ein Kontroll-Tank, der Feinde mit einer harten Betäubung festhält und ein ganzes Gebiet in eine Verlangsamung presst.

champion-horus-skyfall-talon = Horus
    .title = Sturzflug-Kralle
    .lore = Ein Kämpfer, der mit einem betäubenden Falken-Dash herabstößt und Feinde mit schweren, verlangsamenden Hieben zermürbt.

champion-isis-mother-of-magic = Isis
    .title = Mutter der Magie
    .lore = Eine Unterstützerin, gebaut auf einer riesigen Selbstheilung, einem betäubenden Bindezauber und einer langen Flächen-Verlangsamung.

champion-set-lord-of-chaos = Set
    .title = Herr des Chaos
    .lore = Ein Assassine, der eine gewaltige Distanz springt, um auf einem Ziel zu detonieren, sich dann heilt und davonschleicht.

champion-bastet-claws-of-the-hunt = Bastet
    .title = Klauen der Jagd
    .lore = Eine katzenhafte Schützin, deren schnelle Grundangriffe Feinde zerfetzen, kitend mit einer verlangsamenden Kralle und einer Neun-Leben-Regeneration.

## Ember

champion-toran = Toran
    .title = Der Schlackenwächter
    .lore = Ein Frontlinien-Tank, der Kämpfe mit einer schweren Betäubung verankert und sich mit einer schmiedegespeisten Heilung abkühlt.

champion-vashka = Vashka
    .title = Aschenschlund
    .lore = Ein tauchender Kämpfer, der mit einem brennenden Ansturm die Lücke schließt und mit klebrigen Verlangsamungen und Selbsterhaltung austauscht.

champion-ysmera = Ysmera
    .title = Die Scheiterhaufen-Orakel
    .lore = Eine zerbrechliche Burst-Magierin, deren Flächendetonationen und weitreichende Lanze Zerbrechliche in einer einzigen Rotation auslöschen.

champion-kaeza = Kaeza
    .title = Die Glutschließerin
    .lore = Eine Fernschützin mit anhaltendem Schaden, einem durchbohrenden Bolzen und einem Repositionierungssprung.

champion-nerreth = Nerreth
    .title = Der Aschenpirscher
    .lore = Ein Burst-Assassine, der zu einem Ziel blinzelt, ein Betäubungs-und-Burst-Combo abwirft und sich zurückzieht.

## Tide

champion-brackmoor = Brackmoor
    .title = Der Flutwächter
    .lore = Ein Frontlinien-Tank mit einem harten Einfrieren, Selbsterhaltung und einer verlangsamenden Schockwelle zum Schutz der Verbündeten.

champion-nyxralla = Nyxralla
    .title = Die Tiefenruferin
    .lore = Eine zerbrechliche, weitreichende Burst-Magierin, die Ziele mit einer hoch skalierenden Lanze und einer verlangsamenden Blüte detoniert.

champion-cyranth = Cyranth
    .title = Der Riffpirscher
    .lore = Ein Schütze mit hohem anhaltendem Schaden, einem hart treffenden Skillshot und einer Einzelziel-Verlangsamung zum Kiten.

champion-veyl = Veyl
    .title = Die Sogströmung
    .lore = Ein Assassine mit einem lückenschließenden Dash-Burst und einer festsetzenden Hinrichtung — zerbrechlich, aber beweglich.

champion-lumisel = Lumisel
    .title = Die Flutsängerin
    .lore = Eine Verzauberer-Unterstützerin mit zwei unterschiedlich starken Heilungen und einer verlangsamenden Zone mit Splitschaden zum Schutz.

## Verdant

champion-mosscloak = Mosscloak
    .title = Der Hainwächter
    .lore = Ein Frontlinien-Tank, der Schaden aufsaugt, eine einzelne Bedrohung festwurzelt und seine eigene Rinde nachwachsen lässt.

champion-gorehoof = Gorehoof
    .title = Die Blutwurzel
    .lore = Ein tauchender Kämpfer, der beim Aufprall taumeln lässt, Schläge austauscht und aus der Blutwurzel trinkt, um im Kampf zu bleiben.

champion-sporeveil = Sporeveil
    .title = Die Fäulnisblüte
    .lore = Eine zerbrechliche Burst-Magierin, die eine Sporenblüte detoniert, eine Zone mit Pollen erstickt und Nachzügler abschießt.

champion-thornquill = Thornquill
    .title = Der Dornenwächter
    .lore = Ein Schütze, der skalierende Widerhaken regnen lässt, mit einem durchbohrenden Stachel lähmt und wegspringt, um Abstand zu halten.

champion-petalsong = Petalsong
    .title = Die Blütensängerin
    .lore = Eine störende Unterstützerin, die ein Schlüsselziel festhält, eine Gruppe mit rankenden Reben erstickt und ihre eigenen Wunden singt.

## Umbral

champion-dregmaw = Dregmaw
    .title = Das Dämmerbollwerk
    .lore = Ein Frontlinien-Tank, verschmolzen mit Eklipse-Eisen, der Strafe aufsaugt, eine Bedrohung mit einem Schattengriff fesselt und im Dunkeln heilt.

champion-korrathil = Korrathil
    .title = Der Leerenschlinger
    .lore = Ein tauchender Kämpfer, der auf seine Beute kracht, sie festhält und frisst, bis seine eigenen Wunden sich schließen.

champion-xelphine = Xelphine
    .title = Die Eklipse-Seherin
    .lore = Eine zerbrechliche Burst-Magierin, die zu ihren Füßen Schatten erblühen lässt, ferne Beute durchbohrt und eine völlige Nacht herbeiruft.

champion-quorvane = Quorvane
    .title = Nachtglas-Jäger
    .lore = Ein geduldiger Schütze, der Nachtglas-Splitter aus dem Augenwinkel abfeuert und fliehende Beute mit einem durchbohrenden Schuss festnagelt.

champion-zeryth = Zeryth
    .title = Der Umbra-Zahn
    .lore = Ein Burst-Assassine aus lebendem Schatten, der die Distanz zu einem Ziel faltet, es mitten im Schrei festnagelt und in der Dunkelheit erledigt.
