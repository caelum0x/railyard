# Rename to agent.env (same directory) and fill in. Never commit the real file.
# Mirrors the two console-side env vars documented in apps/console/README.md:
#   RAILYARD_WATCH_LIVE=1          (console, turns the feature on)
#   WATCH_AGENT_TOKEN=<this token> (console AND here — same value both places)

# The console's public base URL (no trailing slash).
WATCH_CONSOLE_URL=https://console.example.com

# >= 32 chars, random. Generate with: openssl rand -hex 32
# Must equal the console's WATCH_AGENT_TOKEN exactly.
WATCH_AGENT_TOKEN=

# Usually fine as-is: matches docker-compose.yml's loopback port mapping.
GATUS_URL=http://127.0.0.1:8083

# How often agent.sh takes a pass, in `agent.sh` (no argument, loop mode).
WATCH_POLL_INTERVAL_S=30

# Per-request timeout for every curl call this script makes.
WATCH_HTTP_TIMEOUT_S=10
