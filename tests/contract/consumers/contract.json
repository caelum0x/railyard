{
  "contract": "railyard-consumers",
  "version": 1,
  "package": "Wave P PY1.5 (dispatch 5.3)",
  "env": [
    "RELAY_URL",
    "RELAY_KEY",
    "RAGO_URL",
    "RAGO_API_KEY",
    "MINT_URL",
    "MINT_API_KEY",
    "RAILYARD_LIVE"
  ],
  "secret_env": [
    "RELAY_KEY",
    "RAGO_API_KEY",
    "MINT_API_KEY"
  ],
  "switch": {
    "name": "RAILYARD_LIVE",
    "values": [
      "0",
      "1"
    ],
    "default": "0",
    "meaning": "1 sends usage to Rago and payment mirrors to Mint; 0 keeps the product's own counts only"
  },
  "transaction_id_pattern": "^(scribase|menivor|rally):[a-z0-9_.]+:[A-Za-z0-9_:.-]{1,200}$",
