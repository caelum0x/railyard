{
  "contract": "scribase-bridge",
  "version": 2,
  "package": "Wave P PY1.0 (RYP-E6)",
  "note": "Scribase control-api (CA/adapters/railyard/bridge_client.rs) sends these requests; Railyard console (apps/console/app/api/v1/bridge/scribase) answers. Both sides test against this file. Every request is a POST with Standard Webhooks headers (webhook-id, webhook-timestamp, webhook-signature: v1,<base64 HMAC-SHA256 of id.timestamp.body>) under the shared secret RAILYARD_SCRIBASE_BRIDGE_SECRET (whsec_...). Version 2 (P-Y1): webhook-id is msg_<route>_<24 lowercase hex>, so the route is inside the signed content and a signature made for one route is refused on another (wrong_route); every orgs request carries addon.as_of, Scribase's time of that add-on state in epoch milliseconds, and an orgs request older than the stored state changes nothing and answers stale: true.",
  "base_path": "/api/v1/bridge/scribase",
  "cases": [
    {
      "name": "first use creates the org",
      "route": "orgs",
      "request": {
        "scribase_org_id": "org_fixture",
        "name": "Fixture Co",
        "addon": {
          "active": true,
          "slots": [
            "analytics",
            "deploy",
            "ai"
          ],
          "renews_at": "2026-10-29T12:00:00Z",
          "caps": {
            "apps": 5,
            "analytics_events_month": 3000000
          },
          "as_of": 1790683140000
        }
      },
      "status": 200,
      "response_keys": [
        "addon",
        "created",
        "org_id"
      ],
      "response_match": {
        "created": true,
        "addon": {
          "active": true,
          "slots": [
            "ai",
            "analytics",
            "deploy"
          ]
        }
      }
    },
    {
      "name": "second call returns the same org",
      "route": "orgs",
      "request": {
        "scribase_org_id": "org_fixture",
        "name": "Fixture Co",
        "addon": {
          "active": true,
          "slots": [
            "analytics",
            "deploy",
            "ai"
          ],
          "renews_at": "2026-10-29T12:00:00Z",
          "caps": {
            "apps": 5,
            "analytics_events_month": 3000000
          },
          "as_of": 1790683170000
        }
      },
      "status": 200,
      "response_keys": [
        "addon",
        "created",
        "org_id"
      ],
      "response_match": {
        "created": false
      }
    },
    {
      "name": "claim for an entitled slot",
      "route": "claims",
      "request": {
        "scribase_org_id": "org_fixture",
        "slot": "deploy"
      },
      "status": 200,
      "response_keys": [
        "claim",
        "expires_in",
        "token_endpoint"
      ],
      "response_match": {
        "expires_in": 120
      }
    },
    {
      "name": "claim for a slot outside the add-on",
      "route": "claims",
      "request": {
        "scribase_org_id": "org_fixture",
        "slot": "flags"
      },
      "status": 402,
      "response_keys": [
        "error"
      ]
    },
    {
      "name": "claim for an unknown org",
      "route": "claims",
      "request": {
        "scribase_org_id": "org_unknown",
        "slot": "deploy"
      },
      "status": 404,
      "response_keys": [
        "error"
      ]
    },
    {
      "name": "proof for a slot",
      "route": "proof",
      "request": {
        "scribase_org_id": "org_fixture",
        "slot": "analytics"
      },
      "status": 200,
      "response_keys": [
        "live",
        "next",
        "proof",
        "slot",
        "state"
      ],
      "response_match": {
        "slot": "analytics"
      }
    },
    {
      "name": "deploys for the Scribase Deploy tab",
      "route": "deploys",
      "request": {
        "scribase_org_id": "org_fixture"
      },
      "status": 200,
      "response_keys": [
        "deploys"
      ]
    },
    {
      "name": "deploy proof before the first deploy",
      "route": "proof",
      "request": {
        "scribase_org_id": "org_fixture",
        "slot": "deploy"
      },
      "status": 200,
      "response_keys": [
        "live",
        "next",
        "proof",
        "slot",
        "state"
      ],
      "response_match": {
        "slot": "deploy",
        "state": "no_proof_yet",
        "live": true
      }
    },
    {
      "name": "analytics site for a project environment",
      "route": "sites",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop-prod"
      },
      "status": 200,
      "response_keys": [
        "app",
        "app_id",
        "collector_url",
        "script_url",
        "site_key"
      ],
      "response_match": {
        "app": "shop-prod"
      }
    },
    {
      "name": "analytics tab before Insights is configured",
      "route": "insights",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop-prod"
      },
      "status": 200,
      "response_keys": [
        "available",
        "next"
      ],
      "response_match": {
        "available": false
      }
    },
    {
      "name": "ai gateway for a project environment (the key goes to the control plane only)",
      "route": "ai",
      "request": {
        "scribase_org_id": "org_fixture",
        "project": "shop-prod"
      },
      "status": 200,
      "response_keys": [
        "connect_url",
        "gateway_url",
        "key",
        "providers"
      ]
    },
    {
      "name": "ai tab usage",
      "route": "ai_usage",
      "request": {
        "scribase_org_id": "org_fixture",
        "project": "shop-prod"
      },
      "status": 200,
      "response_keys": [
        "keys",
        "providers",
        "traces"
      ]
    },
    {
      "name": "the add-on lists flags",
      "route": "orgs",
      "request": {
        "scribase_org_id": "org_fixture",
        "name": "Fixture Co",
        "addon": {
          "active": true,
          "slots": [
            "analytics",
            "deploy",
            "ai",
            "flags",
            "uptime"
          ],
          "renews_at": "2026-10-29T12:00:00Z",
          "caps": {
            "apps": 5,
            "analytics_events_month": 3000000
          },
          "as_of": 1790683175000
        }
      },
      "status": 200,
      "response_keys": [
        "addon",
        "created",
        "org_id"
      ],
      "response_match": {
        "addon": {
          "slots": [
            "ai",
            "analytics",
            "deploy",
            "flags",
            "uptime"
          ]
        }
      }
    },
    {
      "name": "flags for a project environment (created on first use)",
      "route": "flags",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop",
        "env": "production"
      },
      "status": 200,
      "response_keys": [
        "app",
        "client_key",
        "created",
        "env",
        "first_read_at",
        "flags",
        "flags_url"
      ],
      "response_match": {
        "app": "shop",
        "env": "production",
        "created": true,
        "flags": []
      }
    },
    {
      "name": "a flag change for a branch that starts from production",
      "route": "flags",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop",
        "env": "feature-x",
        "copy_from": "production",
        "set": {
          "key": "new_checkout",
          "enabled": true,
          "value": "blue"
        }
      },
      "status": 200,
      "response_keys": [
        "app",
        "client_key",
        "created",
        "env",
        "first_read_at",
        "flags",
        "flags_url"
      ],
      "response_match": {
        "env": "feature-x",
        "created": true
      },
      "flags_match": [
        {
          "key": "new_checkout",
          "enabled": true,
          "value": "blue"
        }
      ]
    },
    {
      "name": "uptime check for a project's address",
      "route": "uptime",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop",
        "url": "https://shop.example.com",
        "name": "Shop",
        "owner_email": "owner@example.com"
      },
      "status": 200,
      "response_keys": [
        "app",
        "checks",
        "created"
      ],
      "response_match": {
        "app": "shop",
        "created": true
      }
    },
    {
      "name": "lapsed add-on",
      "route": "orgs",
      "request": {
        "scribase_org_id": "org_fixture",
        "name": "Fixture Co",
        "addon": {
          "active": false,
          "slots": [
            "analytics",
            "deploy",
            "ai"
          ],
          "renews_at": null,
          "caps": {
            "apps": 5,
            "analytics_events_month": 3000000
          },
          "as_of": 1790683190000
        }
      },
      "status": 200,
      "response_keys": [
        "addon",
        "created",
        "org_id"
      ],
      "response_match": {
        "created": false,
        "addon": {
          "active": false
        }
      }
    },
    {
      "name": "a late activation older than the lapse changes nothing",
      "route": "orgs",
      "request": {
        "scribase_org_id": "org_fixture",
        "name": "Fixture Co",
        "addon": {
          "active": true,
          "slots": [
            "analytics",
            "deploy",
            "ai"
          ],
          "renews_at": "2026-10-29T12:00:00Z",
          "caps": {
            "apps": 5,
            "analytics_events_month": 3000000
          },
          "as_of": 1790683180000
        }
      },
      "status": 200,
      "response_keys": [
        "addon",
        "created",
        "org_id",
        "stale"
      ],
      "response_match": {
        "stale": true,
        "addon": {
          "active": false
        }
      }
    },
    {
      "name": "claim after the add-on lapsed",
      "route": "claims",
      "request": {
        "scribase_org_id": "org_fixture",
        "slot": "deploy"
      },
      "status": 402,
      "response_keys": [
        "error"
      ]
    },
    {
      "name": "flags after the add-on lapsed",
      "route": "flags",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop",
        "env": "production"
      },
      "status": 402,
      "response_keys": [
        "error"
      ]
    },
    {
      "name": "uptime after the add-on lapsed",
      "route": "uptime",
      "request": {
        "scribase_org_id": "org_fixture",
        "app": "shop"
      },
      "status": 402,
      "response_keys": [
        "error"
      ]
    }
  ],
  "unsigned": {
    "status": 401,
    "response_keys": [
      "error"
    ]
  },
  "replayed_id": {
    "status": 409,
    "response_keys": [
      "error"
    ]
  },
  "slot_state": {
    "states": [
      "live",
      "arriving",
      "not_entitled",
      "no_proof_yet"
    ],
    "proof": {
      "kind": "string",
      "id": "string",
      "at": "RFC 3339 string"
    }
  },
  "signature_vector": {
    "secret": "whsec_Y29udHJhY3QtZml4dHVyZS1zZWNyZXQtMzItYnl0ZXM=",
    "id": "msg_proof_0123456789abcdef01234567",
    "timestamp": "1790683200",
    "body": "{\"scribase_org_id\":\"org_fixture\",\"slot\":\"deploy\"}",
    "signature": "v1,6uDtRSMzCTvrYX+R1jcSoP6UWaxQ3cljO9tF0cIFoS8="
  },
  "insights_answer_keys": [
    "app",
    "available",
    "cap_note",
    "events",
    "events_limit",
    "first_event_at",
    "funnel",
    "month_events",
    "visitors"
  ],
  "id_format": "^msg_(orgs|claims|proof|deploys|sites|insights|ai|ai_usage|flags|uptime)_[0-9a-f]{24}$",
  "wrong_route": {
    "status": 401,
    "response_keys": [
      "error"
    ],
    "note": "a request signed with an id for proof, delivered to claims"
  },
  "flags_answer_keys": [
    "app",
    "client_key",
    "created",
    "env",
    "first_read_at",
    "flags",
    "flags_url"
  ],
  "flags_item_keys": [
    "description",
    "enabled",
    "key",
    "updated_at",
    "value"
  ],
  "uptime_check_keys": [
    "app",
    "first_result_at",
    "id",
    "last_checked_at",
    "name",
    "paused",
    "state",
    "status_url",
    "url"
  ]
}
